#!/usr/bin/env bash
# Fun Detective 提交前审查钩子
# 功能：检查敏感信息、禁止提交的文件、大文件等
# 使用：git config core.hooksPath .githooks

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

ERRORS=0
WARNINGS=0

# 获取暂存区的文件列表（新增或修改的文件）
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}✓ 无暂存文件，跳过审查${NC}"
    exit 0
fi

echo "========================================"
echo "  Fun Detective 提交前审查"
echo "========================================"
echo ""

# ============================================
# 检查 1：禁止提交的文件名
# ============================================
echo -e "${YELLOW}[1/4] 检查禁止提交的文件...${NC}"

FORBIDDEN_PATTERNS=(
    '\.env$'
    '\.env\.local$'
    '\.env\..*\.local$'
    '^temp_'
    '\.log$'
    '^\.astro/'
    '^dist/'
    '^node_modules/'
    '^\.superpowers/'
    '^\.lark-cli/'
    '^server\.log$'
    '^astro-dev.*\.log$'
    '^dev_server.*\.log$'
)

for file in $STAGED_FILES; do
    for pattern in "${FORBIDDEN_PATTERNS[@]}"; do
        if echo "$file" | grep -qE "$pattern"; then
            echo -e "  ${RED}✗ 禁止提交: $file (匹配规则: $pattern)${NC}"
            ERRORS=$((ERRORS + 1))
        fi
    done
done

if [ $ERRORS -eq 0 ]; then
    echo -e "  ${GREEN}✓ 无禁止提交的文件${NC}"
fi
echo ""

# ============================================
# 检查 2：敏感信息扫描
# ============================================
echo -e "${YELLOW}[2/4] 扫描敏感信息...${NC}"

# 敏感信息正则模式
SENSITIVE_PATTERNS=(
    # 飞书应用凭证
    'LARK_APP_SECRET\s*=\s*[A-Za-z0-9]{20,}'
    'LARK_APP_ID\s*=\s*cli_[A-Za-z0-9]{10,}'
    # 通用 API Key / Token
    'api[_-]?key\s*[:=]\s*["'\'']?[A-Za-z0-9_\-]{20,}["'\'']?'
    'secret\s*[:=]\s*["'\'']?[A-Za-z0-9_\-]{20,}["'\'']?'
    'token\s*[:=]\s*["'\'']?[A-Za-z0-9_\-]{20,}["'\'']?'
    'password\s*[:=]\s*["'\'']?[^"'\'']{6,}["'\'']?'
    # AWS / 云服务密钥
    'AKIA[0-9A-Z]{16}'
    'AIza[0-9A-Za-z\-_]{35}'
    # 私钥
    'BEGIN [RSA DSA EC OPENSSH] PRIVATE KEY'
    # 飞书 Base Token（真实值，非占位符）
    'LARK_BASE_TOKEN\s*=\s*[A-Za-z0-9]{15,}'
    'LARK_MAIN_TABLE_ID\s*=\s*tbl[A-Za-z0-9]{10,}'
    'LARK_SUB_TABLE_ID\s*=\s*tbl[A-Za-z0-9]{10,}'
)

# 需要扫描内容的文件类型（排除二进制和媒体文件）
SCANNABLE_EXTENSIONS=('js' 'ts' 'mjs' 'cjs' 'json' 'yml' 'yaml' 'md' 'txt' 'py' 'sh' 'bash' 'ps1' 'bat' 'env' 'example' 'astro' 'css' 'html' 'xml' 'toml' 'ini' 'cfg' 'conf')

for file in $STAGED_FILES; do
    # 检查文件扩展名是否需要扫描
    ext="${file##*.}"
    should_scan=false
    for scannable in "${SCANNABLE_EXTENSIONS[@]}"; do
        if [ "$ext" = "$scannable" ]; then
            should_scan=true
            break
        fi
    done

    # 无扩展名的文件（如 Dockerfile, Makefile）也扫描
    if [ "$ext" = "$file" ]; then
        should_scan=true
    fi

    if [ "$should_scan" = false ]; then
        continue
    fi

    # 检查文件是否存在（可能是删除的文件）
    if [ ! -f "$file" ]; then
        continue
    fi

    for pattern in "${SENSITIVE_PATTERNS[@]}"; do
        # 使用 git show 获取暂存区的文件内容，避免扫描工作区未暂存的修改
        content=$(git show ":$file" 2>/dev/null || true)
        if echo "$content" | grep -qiE "$pattern"; then
            # 排除 .env.example 和文档中的占位符示例
            if echo "$file" | grep -qE '\.example$|SECURITY_CHECKLIST|README'; then
                # 进一步检查是否是占位符（包含 xxxxx, your_, example 等）
                matched_line=$(echo "$content" | grep -iE "$pattern" | head -1)
                if echo "$matched_line" | grep -qiE 'xxxxx|your_|example|placeholder|占位|替换'; then
                    continue
                fi
            fi
            echo -e "  ${RED}✗ 敏感信息: $file${NC}"
            echo -e "    ${RED}匹配模式: $pattern${NC}"
            ERRORS=$((ERRORS + 1))
        fi
    done
done

if [ $ERRORS -eq 0 ] || [ $(git diff --cached --name-only --diff-filter=ACM | wc -l) -eq 0 ]; then
    # 重新计算是否有敏感信息错误
    SENSITIVE_ERRORS=0
    for file in $STAGED_FILES; do
        ext="${file##*.}"
        should_scan=false
        for scannable in "${SCANNABLE_EXTENSIONS[@]}"; do
            if [ "$ext" = "$scannable" ]; then should_scan=true; break; fi
        done
        if [ "$ext" = "$file" ]; then should_scan=true; fi
        if [ "$should_scan" = false ] || [ ! -f "$file" ]; then continue; fi
        for pattern in "${SENSITIVE_PATTERNS[@]}"; do
            content=$(git show ":$file" 2>/dev/null || true)
            if echo "$content" | grep -qiE "$pattern"; then
                if echo "$file" | grep -qE '\.example$|SECURITY_CHECKLIST'; then continue; fi
                matched_line=$(echo "$content" | grep -iE "$pattern" | head -1)
                if echo "$matched_line" | grep -qiE 'xxxxx|your_|example|placeholder|占位|替换'; then continue; fi
                SENSITIVE_ERRORS=$((SENSITIVE_ERRORS + 1))
            fi
        done
    done
    if [ $SENSITIVE_ERRORS -eq 0 ]; then
        echo -e "  ${GREEN}✓ 未发现敏感信息${NC}"
    fi
fi
echo ""

# ============================================
# 检查 3：大文件检查
# ============================================
echo -e "${YELLOW}[3/4] 检查大文件...${NC}"

MAX_SIZE=1048576  # 1MB
MEDIA_EXTENSIONS=('png' 'jpg' 'jpeg' 'gif' 'webp' 'svg' 'ico' 'mp4' 'webm' 'mp3' 'wav' 'woff' 'woff2' 'ttf' 'eot' 'otf' 'pdf' 'zip')

for file in $STAGED_FILES; do
    if [ ! -f "$file" ]; then
        continue
    fi

    file_size=$(stat -c%s "$file" 2>/dev/null || stat -f%z "$file" 2>/dev/null || echo 0)

    if [ "$file_size" -gt "$MAX_SIZE" ]; then
        ext="${file##*.}"
        is_media=false
        for media_ext in "${MEDIA_EXTENSIONS[@]}"; do
            if [ "$ext" = "$media_ext" ]; then
                is_media=true
                break
            fi
        done

        size_mb=$((file_size / 1048576))
        size_kb=$(( (file_size % 1048576) / 1024 ))
        size_display="${size_mb}.${size_kb}MB"

        if [ "$is_media" = true ]; then
            echo -e "  ${YELLOW}⚠ 大文件(媒体): $file (${size_display})${NC}"
            WARNINGS=$((WARNINGS + 1))
        else
            echo -e "  ${RED}✗ 大文件: $file (${size_display})，超过 1MB 限制${NC}"
            ERRORS=$((ERRORS + 1))
        fi
    fi
done

echo -e "  ${GREEN}✓ 大文件检查完成${NC}"
echo ""

# ============================================
# 检查 4：案件数据 JSON 格式验证
# ============================================
echo -e "${YELLOW}[4/4] 验证案件数据 JSON 格式...${NC}"

JSON_ERRORS=0
for file in $STAGED_FILES; do
    if echo "$file" | grep -qE '^cases/.*\.json$'; then
        if [ ! -f "$file" ]; then
            continue
        fi
        if ! python3 -c "import json; json.load(open('$file', 'r', encoding='utf-8'))" 2>/dev/null; then
            if ! python -c "import json; json.load(open('$file', 'r', encoding='utf-8'))" 2>/dev/null; then
                echo -e "  ${RED}✗ JSON 格式错误: $file${NC}"
                JSON_ERRORS=$((JSON_ERRORS + 1))
                ERRORS=$((ERRORS + 1))
            fi
        fi
    fi
done

if [ $JSON_ERRORS -eq 0 ]; then
    echo -e "  ${GREEN}✓ 所有案件数据 JSON 格式正确${NC}"
fi
echo ""

# ============================================
# 总结
# ============================================
echo "========================================"
if [ $ERRORS -gt 0 ]; then
    echo -e "  ${RED}✗ 审查未通过: $ERRORS 个错误, $WARNINGS 个警告${NC}"
    echo ""
    echo "  请修复上述问题后重新提交。"
    echo "  如需跳过此检查（不推荐），使用: git commit --no-verify"
    echo "========================================"
    exit 1
else
    echo -e "  ${GREEN}✓ 审查通过: 0 个错误, $WARNINGS 个警告${NC}"
    echo "========================================"
    if [ $WARNINGS -gt 0 ]; then
        echo ""
        echo -e "  ${YELLOW}提示: 有 $WARNINGS 个警告，请确认是否符合预期。${NC}"
    fi
    exit 0
fi
