---
import BaseLayout from '@layouts/BaseLayout.astro';
import CaseCard from '@components/CaseCard.astro';
import { loadAllCases, getSourceTypes, getRegions, getContinents } from '@lib/caseLoader';

export async function getStaticPaths() {
  // 生成三种分类页面：来源类型、大洲、国家/地区
  const types = [...getSourceTypes(), ...getContinents(), ...getRegions()];
  return types.map((type) => ({
    params: { type },
    props: { type },
  }));
}

const { type } = Astro.params;
const allCases = loadAllCases();

// 判断是按来源类型、大洲还是国家筛选
const isSourceType = getSourceTypes().includes(type);
const isContinent = getContinents().includes(type);
const isRegion = getRegions().includes(type);

const filteredCases = allCases.filter((c) => {
  if (isSourceType) return c.sourceType === type;
  if (isContinent) return c.continent === type;
  if (isRegion) return c.region === type;
  return false;
});

let categoryTitle = '';
if (isSourceType) categoryTitle = `来源：${type}`;
else if (isContinent) categoryTitle = `大洲：${type}`;
else if (isRegion) categoryTitle = `国家/地区：${type}`;
else categoryTitle = type;

const PAGE_SIZE = 12;
---

<BaseLayout title={categoryTitle} description={`${categoryTitle}的案件列表`}>
  <section class="py-10">
    <div class="container-page">
      <nav class="text-sm text-stone-500 mb-4">
        <a href="/fun_detective/" class="hover:text-primary-600">首页</a>
        <span class="mx-2">/</span>
        <span class="text-stone-700">{categoryTitle}</span>
      </nav>

      <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
        <h1 class="text-3xl font-bold">{categoryTitle}</h1>
        <span id="result-count" class="text-stone-500">共 {filteredCases.length} 条案件</span>
      </div>

      {filteredCases.length > 0 ? (
        <>
          {/* 分类内搜索与排序（复用首页浏览逻辑） */}
          <div class="flex flex-col sm:flex-row gap-3 mb-8">
            <div class="flex-1 relative">
              <label for="category-search" class="sr-only">在当前分类内搜索</label>
              <input
                type="text"
                id="category-search"
                placeholder="在当前分类内搜索名称、简介、诡计…"
                class="input pl-10"
                aria-describedby="category-live"
              />
              <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-stone-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <label class="sr-only" for="category-sort">排序方式</label>
            <select id="category-sort" class="input w-auto">
              <option value="date">最新录入</option>
              <option value="name">名称排序</option>
              <option value="difficulty-desc">难度从高到低</option>
              <option value="difficulty-asc">难度从低到高</option>
            </select>
          </div>

          <div id="category-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {filteredCases.map((caseData) => (
              <CaseCard caseData={caseData} />
            ))}
          </div>
          <div id="category-no-results" class="hidden text-center py-16">
            <p class="text-stone-500">当前分类下没有匹配的案件</p>
          </div>
          <div id="category-load-more" class="text-center mt-8">
            <button id="category-load-more-btn" class="btn btn-primary">加载更多</button>
          </div>
          <div id="category-live" class="sr-only" role="status" aria-live="polite"></div>
        </>
      ) : (
        <div class="text-center py-16">
          <p class="text-stone-500">该分类下暂无案件</p>
        </div>
      )}
    </div>
  </section>

  {filteredCases.length > 0 && (
    <script>
      import { initCaseBrowser } from '../../scripts/case-browser';
      initCaseBrowser({
        grid: document.getElementById('category-grid')!,
        search: document.getElementById('category-search') as HTMLInputElement,
        sort: document.getElementById('category-sort') as HTMLSelectElement,
        loadMoreBtn: document.getElementById('category-load-more-btn') as HTMLButtonElement,
        loadMoreContainer: document.getElementById('category-load-more')!,
        count: document.getElementById('result-count'),
        noResults: document.getElementById('category-no-results')!,
        live: document.getElementById('category-live')!,
        pageSize: 12,
        syncUrl: true,
      });
    </script>
  )}
</BaseLayout>
