---
import BaseLayout from '@layouts/BaseLayout.astro';
import CaseCard from '@components/CaseCard.astro';
import { loadAllCases, getSourceTypes, getRegions, getContinents } from '@lib/caseLoader';

export async function getStaticPaths() {
  // 生成三种分类页面：来源类型、大洲、国家/地区
  const types = [...getSourceTypes(), ...getContinents(), ...getRegions()];
  return types.map((type) => ({
    params: { type },
    props: { type },
  }));
}

const { type } = Astro.params;
const allCases = loadAllCases();

// 判断是按来源类型、大洲还是国家筛选
const isSourceType = getSourceTypes().includes(type);
const isContinent = getContinents().includes(type);
const isRegion = getRegions().includes(type);

const filteredCases = allCases.filter((c) => {
  if (isSourceType) return c.sourceType === type;
  if (isContinent) return c.continent === type;
  if (isRegion) return c.region === type;
  return false;
});

let categoryTitle = '';
if (isSourceType) categoryTitle = `来源：${type}`;
else if (isContinent) categoryTitle = `大洲：${type}`;
else if (isRegion) categoryTitle = `国家/地区：${type}`;
else categoryTitle = type;
---

<BaseLayout title={categoryTitle} description={`${categoryTitle}的案件列表`}>
  <section class="py-10">
    <div class="container-page">
      <nav class="text-sm text-stone-500 mb-4">
        <a href="/fun_detective/" class="hover:text-primary-600">首页</a>
        <span class="mx-2">/</span>
        <span class="text-stone-700">{categoryTitle}</span>
      </nav>

      <div class="flex items-center justify-between mb-8">
        <h1 class="text-3xl font-bold">{categoryTitle}</h1>
        <span class="text-stone-500">共 {filteredCases.length} 条案件</span>
      </div>

      {filteredCases.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {filteredCases.map((caseData) => (
            <CaseCard caseData={caseData} />
          ))}
        </div>
      ) : (
        <div class="text-center py-16">
          <p class="text-stone-500">该分类下暂无案件</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
