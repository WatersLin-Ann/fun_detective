---
import BaseLayout from '@layouts/BaseLayout.astro';
import CaseCard from '@components/CaseCard.astro';
import { loadAllCases, getStats, getSourceTypes, getContinents, getRegionsByContinent } from '@lib/caseLoader';

const cases = loadAllCases();
const stats = getStats();

// 从实际数据动态提取筛选选项
const sourceTypes = getSourceTypes();
const continents = getContinents();

// 预先生成大洲→国家映射，用于二级菜单
const continentCountries: Record<string, string[]> = {};
for (const continent of continents) {
  continentCountries[continent] = getRegionsByContinent(continent);
}

// 每页显示数量
const PAGE_SIZE = 12;
---

<BaseLayout title="首页" description="全球虚拟真实案件案例库，为小说创作和游戏设计提供灵感">
  <!-- Hero 区域 -->
  <section class="bg-gradient-to-br from-primary-950 via-primary-900 to-primary-800 text-white py-16">
    <div class="container-page">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl font-bold mb-4 animate-fade-in">
          探索全球<span class="text-accent-400">案件</span>的奥秘
        </h1>
        <p class="text-lg text-primary-200 mb-8 animate-fade-in-delay-1">
          汇集推理小说、真实案件、影视游戏中的经典案例，为小说创作和游戏设计提供结构化的灵感与参考。
        </p>
        <div class="flex flex-wrap gap-8 animate-fade-in-delay-2">
          <div>
            <div class="text-3xl font-bold text-accent-400">{stats.total}</div>
            <div class="text-sm text-primary-300">案件总数</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-accent-400">{Object.keys(stats.bySourceType).length}</div>
            <div class="text-sm text-primary-300">来源类型</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-accent-400">{Object.keys(stats.byContinent).length}</div>
            <div class="text-sm text-primary-300">覆盖大洲</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-accent-400">{Object.keys(stats.byRegion).length}</div>
            <div class="text-sm text-primary-300">国家/地区</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-accent-400">{stats.avgDifficulty}</div>
            <div class="text-sm text-primary-300">平均难度</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 搜索和筛选 -->
  <section class="py-8 bg-white border-b border-stone-200 sticky top-16 z-40">
    <div class="container-page">
      <div class="flex flex-col md:flex-row gap-4">
        <!-- 搜索框 -->
        <div class="flex-1 relative">
          <input
            type="text"
            id="search-input"
            placeholder="搜索案件名称、简介、诡计...（支持模糊匹配）"
            class="input pl-10"
          />
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <!-- 筛选器 -->
        <div class="flex flex-wrap gap-3 items-center">
          <select id="filter-source" class="input w-auto">
            <option value="">全部类型</option>
            {sourceTypes.map((type) => <option value={type}>{type}</option>)}
          </select>

          <!-- 自定义二级下拉菜单：地区→国家 -->
          <div class="region-dropdown" id="region-dropdown">
            <button type="button" class="input w-auto flex items-center justify-between gap-2 cursor-pointer" id="region-trigger">
              <span id="region-trigger-text">全部地区</span>
              <svg class="w-4 h-4 text-stone-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="region-menu" id="region-menu">
              <!-- 全部地区 -->
              <div class="region-menu-item" data-region="" data-continent="">
                <span>全部地区</span>
              </div>
              <!-- 各地区分组 -->
              {continents.map((continent) => {
                const countries = continentCountries[continent] || [];
                const hasChildren = countries.length > 0;
                return (
                  <div class={`region-menu-item ${hasChildren ? 'has-children' : ''}`} data-continent={continent}>
                    <span class="region-menu-label">{continent}</span>
                    {hasChildren && (
                      <>
                        <svg class="w-4 h-4 text-stone-400 ml-auto flex-shrink-0 submenu-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                        <div class="region-submenu">
                          <div class="region-submenu-title">{continent} · 全部国家</div>
                          <div class="region-submenu-item" data-region="" data-continent={continent}>
                            全部国家
                          </div>
                          {countries.map((country) => (
                            <div class="region-submenu-item" data-region={country} data-continent={continent}>
                              {country}
                            </div>
                          ))}
                        </div>
                      </>
                    )}
                  </div>
                );
              })}
            </div>
          </div>

          <select id="filter-sort" class="input w-auto">
            <option value="date">最新录入</option>
            <option value="name">名称排序</option>
            <option value="difficulty-desc">难度从高到低</option>
            <option value="difficulty-asc">难度从低到高</option>
          </select>
        </div>
      </div>
    </div>
  </section>

  <!-- 案件列表 -->
  <section class="py-12">
    <div class="container-page">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold">全部案件</h2>
        <span id="result-count" class="text-stone-500">共 {cases.length} 条</span>
      </div>
      <div id="case-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {cases.map((caseData) => (
          <CaseCard caseData={caseData} />
        ))}
      </div>
      <div id="no-results" class="hidden text-center py-16">
        <svg class="w-16 h-16 mx-auto text-stone-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="text-stone-500">没有找到匹配的案件</p>
      </div>
      <!-- 加载更多按钮 -->
      <div id="load-more-container" class="text-center mt-8">
        <button id="load-more-btn" class="btn btn-primary">
          加载更多
        </button>
      </div>
    </div>
  </section>

  <style>
    /* 二级下拉菜单样式 */
    .region-dropdown {
      position: relative;
    }
    .region-menu {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      margin-top: 4px;
      background: white;
      border: 1px solid #e7e5e4;
      border-radius: 8px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.1);
      min-width: 160px;
      z-index: 50;
      padding: 4px 0;
    }
    .region-dropdown.open .region-menu {
      display: block;
    }
    .region-menu-item {
      display: flex;
      align-items: center;
      padding: 8px 14px;
      cursor: pointer;
      font-size: 14px;
      color: #44403c;
      position: relative;
      transition: background 0.15s;
    }
    .region-menu-item:hover {
      background: #f5f5f4;
    }
    .region-menu-item.has-children:hover {
      background: #f5f5f4;
    }
    .region-menu-label {
      flex: 1;
    }
    /* 二级子菜单：PC端hover显示 */
    .region-submenu {
      display: none;
      position: absolute;
      left: 100%;
      top: -4px;
      margin-left: 2px;
      background: white;
      border: 1px solid #e7e5e4;
      border-radius: 8px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.1);
      min-width: 140px;
      z-index: 51;
      padding: 4px 0;
    }
    .region-menu-item.has-children:hover > .region-submenu {
      display: block;
    }
    .region-submenu-title {
      padding: 6px 14px;
      font-size: 12px;
      color: #a8a29e;
      border-bottom: 1px solid #f5f5f4;
      margin-bottom: 2px;
    }
    .region-submenu-item {
      padding: 8px 14px;
      cursor: pointer;
      font-size: 14px;
      color: #44403c;
      transition: background 0.15s;
    }
    .region-submenu-item:hover {
      background: #f5f5f4;
      color: #1c1917;
    }
    /* 移动端：点击展开二级 */
    @media (max-width: 768px) {
      .region-menu-item.has-children.open-submenu > .region-submenu {
        display: block;
        position: static;
        margin-left: 0;
        margin-top: 4px;
        box-shadow: none;
        border: none;
        background: #fafaf9;
        border-radius: 4px;
      }
      .region-menu-item.has-children.open-submenu .submenu-arrow {
        transform: rotate(90deg);
      }
      .submenu-arrow {
        transition: transform 0.2s;
      }
    }
  </style>

  <script>
    // 导入 fuse.js 模糊搜索
    import Fuse from 'fuse.js';

    // 客户端搜索和筛选
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const filterSource = document.getElementById('filter-source') as HTMLSelectElement;
    const filterSort = document.getElementById('filter-sort') as HTMLSelectElement;
    const caseGrid = document.getElementById('case-grid')!;
    const noResults = document.getElementById('no-results')!;
    const resultCount = document.getElementById('result-count')!;
    const loadMoreBtn = document.getElementById('load-more-btn')!;
    const loadMoreContainer = document.getElementById('load-more-container')!;

    // 二级下拉菜单元素
    const regionDropdown = document.getElementById('region-dropdown')!;
    const regionTrigger = document.getElementById('region-trigger')!;
    const regionTriggerText = document.getElementById('region-trigger-text')!;
    const regionMenu = document.getElementById('region-menu')!;

    // 当前选中的筛选值
    let selectedRegion = '';      // 国家名，空表示全部
    let selectedContinent = '';   // 大洲名，空表示全部

    // 检测是否为触屏设备
    const isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0;

    // 分页配置
    const PAGE_SIZE = 12;
    let currentPage = 1;
    let currentFiltered: CaseItem[] = [];

    // 从 DOM 中提取所有案件数据
    interface CaseItem {
      element: HTMLElement;
      name: string;
      source: string;
      continent: string;
      region: string;
      difficulty: number;
      date: string;
      searchText: string;
    }

    const caseItems: CaseItem[] = Array.from(caseGrid.querySelectorAll('[data-case]')).map((el) => {
      const element = el as HTMLElement;
      return {
        element,
        name: element.dataset.name || '',
        source: element.dataset.source || '',
        continent: element.dataset.continent || '',
        region: element.dataset.region || '',
        difficulty: parseFloat(element.dataset.difficulty || '0'),
        date: element.dataset.date || '',
        searchText: (element.dataset.searchtext || '').toLowerCase(),
      };
    });

    // 初始化 fuse.js 模糊搜索
    const fuse = new Fuse(caseItems, {
      keys: [
        { name: 'name', weight: 0.5 },
        { name: 'searchText', weight: 0.3 },
        { name: 'source', weight: 0.1 },
        { name: 'region', weight: 0.1 },
      ],
      threshold: 0.4,
      includeScore: true,
      minMatchCharLength: 1,
    });

    // ===== 二级下拉菜单逻辑 =====

    // 打开/关闭下拉
    function toggleDropdown(open?: boolean) {
      const shouldOpen = open !== undefined ? open : !regionDropdown.classList.contains('open');
      regionDropdown.classList.toggle('open', shouldOpen);
      if (!shouldOpen) {
        // 关闭时收起所有移动端展开的子菜单
        regionMenu.querySelectorAll('.has-children.open-submenu').forEach((el) => {
          el.classList.remove('open-submenu');
        });
      }
    }

    // 更新触发按钮显示文本
    function updateTriggerText() {
      if (selectedRegion) {
        regionTriggerText.textContent = selectedRegion;
      } else if (selectedContinent) {
        regionTriggerText.textContent = `${selectedContinent} · 全部`;
      } else {
        regionTriggerText.textContent = '全部地区';
      }
    }

    // 选中一个值（国家或大洲）
    function selectRegion(region: string, continent: string) {
      selectedRegion = region;
      selectedContinent = continent;
      updateTriggerText();
      toggleDropdown(false);
      applyFilters();
    }

    // 点击触发按钮
    regionTrigger.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleDropdown();
    });

    // 点击菜单项
    regionMenu.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      // 点击了子菜单项（国家或全部国家）
      const submenuItem = target.closest('.region-submenu-item') as HTMLElement | null;
      if (submenuItem) {
        e.stopPropagation();
        const region = submenuItem.dataset.region || '';
        const continent = submenuItem.dataset.continent || '';
        selectRegion(region, continent);
        return;
      }

      // 点击了一级菜单项
      const menuItem = target.closest('.region-menu-item') as HTMLElement | null;
      if (menuItem) {
        e.stopPropagation();
        const hasChildren = menuItem.classList.contains('has-children');

        if (isTouchDevice && hasChildren) {
          // 移动端：有子菜单的项点击展开/收起子菜单
          menuItem.classList.toggle('open-submenu');
        } else if (!hasChildren) {
          // 无子菜单的项（全部地区）直接选中
          const region = menuItem.dataset.region || '';
          const continent = menuItem.dataset.continent || '';
          selectRegion(region, continent);
        }
        // PC端有子菜单的项靠hover显示子菜单，点击不做操作
      }
    });

    // 点击外部关闭下拉
    document.addEventListener('click', (e) => {
      if (!regionDropdown.contains(e.target as Node)) {
        toggleDropdown(false);
      }
    });

    // ===== 筛选和显示逻辑 =====

    // 更新显示（支持分页）
    function updateDisplay() {
      caseItems.forEach((item) => {
        item.element.style.display = 'none';
      });

      const endIndex = currentPage * PAGE_SIZE;
      const toShow = currentFiltered.slice(0, endIndex);
      toShow.forEach((item) => {
        caseGrid.appendChild(item.element);
        item.element.style.display = '';
      });

      if (endIndex >= currentFiltered.length) {
        loadMoreContainer.classList.add('hidden');
      } else {
        loadMoreContainer.classList.remove('hidden');
        loadMoreBtn.textContent = `加载更多（已显示 ${toShow.length}/${currentFiltered.length}）`;
      }

      resultCount.textContent = `共 ${currentFiltered.length} 条`;
      noResults.classList.toggle('hidden', currentFiltered.length > 0);
    }

    function applyFilters() {
      const query = searchInput.value.trim();
      const source = filterSource.value;
      const sort = filterSort.value;

      // 先用 fuse.js 进行模糊搜索
      let filtered: CaseItem[];
      if (query) {
        const results = fuse.search(query);
        filtered = results.map((r) => r.item);
      } else {
        filtered = [...caseItems];
      }

      // 应用类型、地区/国家筛选
      filtered = filtered.filter((item) => {
        const matchSource = !source || item.source === source;
        // 选了具体国家 → 按国家匹配
        const matchRegion = !selectedRegion || item.region === selectedRegion;
        // 没选国家但选了大洲 → 按大洲匹配
        const matchContinent = !selectedContinent || selectedRegion || item.continent === selectedContinent;
        return matchSource && matchRegion && matchContinent;
      });

      // 排序
      if (!query || sort !== 'date') {
        filtered.sort((a, b) => {
          switch (sort) {
            case 'name':
              return a.name.localeCompare(b.name, 'zh-CN');
            case 'difficulty-desc':
              return b.difficulty - a.difficulty;
            case 'difficulty-asc':
              return a.difficulty - b.difficulty;
            case 'date':
            default:
              return b.date.localeCompare(a.date);
          }
        });
      }

      currentFiltered = filtered;
      currentPage = 1;
      updateDisplay();
    }

    // 加载更多
    loadMoreBtn.addEventListener('click', () => {
      currentPage++;
      updateDisplay();
    });

    searchInput.addEventListener('input', applyFilters);
    filterSource.addEventListener('change', applyFilters);
    filterSort.addEventListener('change', applyFilters);

    // 初始化显示
    applyFilters();
  </script>
</BaseLayout>
