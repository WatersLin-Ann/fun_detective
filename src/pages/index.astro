---
import BaseLayout from '@layouts/BaseLayout.astro';
import CaseCard from '@components/CaseCard.astro';
import { loadAllCases, getStats, getSourceTypes, getContinents, getRegionsByContinent } from '@lib/caseLoader';

const cases = loadAllCases();
const stats = getStats();

// 从实际数据动态提取筛选选项
const sourceTypes = getSourceTypes();
const continents = getContinents();

// 预先生成大洲→国家映射，用于二级菜单
const continentCountries: Record<string, string[]> = {};
for (const continent of continents) {
  continentCountries[continent] = getRegionsByContinent(continent);
}

// 每页显示数量
const PAGE_SIZE = 50;

// Hero「案件速览」：按日期确定性轮换，构建时选出初始 3 条
const orderedPicks = [...cases].sort((a, b) => a.slug.localeCompare(b.slug, 'zh-CN'));
const now = new Date();
const dayOfYear = Math.floor(
  (now.getTime() - new Date(now.getFullYear(), 0, 0).getTime()) / 86400000,
);
const pickOffset = orderedPicks.length > 0 ? dayOfYear % orderedPicks.length : 0;
const heroPicks = [0, 1, 2].map(
  (i) => orderedPicks[(pickOffset + i) % Math.max(orderedPicks.length, 1)],
).filter(Boolean);
// 供客户端「换一批」使用的精简数据
const pickData = orderedPicks.map((c) => ({
  slug: `/fun_detective/case/${c.slug}`,
  name: c.基本信息.案件名称,
  source: c.sourceType,
  region: c.region,
  difficulty: (c.设计视图.难度评分?.综合 || 0).toFixed(1),
}));
// 数据最近录入时间
const latestDate = cases
  .map((c) => c.元数据?.录入日期 || '')
  .sort()
  .pop() || '';
---

<BaseLayout title="首页" description="全球虚拟真实案件案例库，为小说创作和游戏设计提供灵感">
  <!-- Hero 区域 -->
  <section class="bg-gradient-to-br from-primary-950 via-primary-900 to-primary-800 text-white py-8">
    <div class="container-page">
      <div class="flex flex-col lg:flex-row gap-6 lg:gap-10 items-center">
        <!-- 左侧：主张与统计 -->
        <div class="flex-1 min-w-0 w-full">
          <h1 class="text-2xl md:text-3xl font-bold mb-3 animate-fade-in">
            探索全球<span class="text-accent-400">经典案件</span>的诡计与叙事
          </h1>
          <p class="text-base text-primary-200 mb-5 animate-fade-in-delay-1 max-w-2xl">
            汇集推理小说、真实案件、影视游戏中的经典案例，为推理爱好者和创作者提供结构化的案件参考与延伸阅读指引。
          </p>
          <div class="flex flex-wrap gap-x-6 gap-y-2 animate-fade-in-delay-2">
            <div>
              <div class="text-2xl font-bold text-accent-400">{stats.total}</div>
              <div class="text-xs text-primary-300 inline-flex items-center gap-1">
                案件总数
                <button type="button" class="stat-info" aria-label="案件总数口径：库内全部案件条目数，按条目去重" title="口径：库内全部案件条目数，按条目去重">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </button>
              </div>
            </div>
            <div>
              <div class="text-2xl font-bold text-accent-400">{Object.keys(stats.bySourceType).length}</div>
              <div class="text-xs text-primary-300 inline-flex items-center gap-1">
                来源类型
                <button type="button" class="stat-info" aria-label="来源类型口径：按来源类型去重后的数量" title="口径：按来源类型去重后的数量">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </button>
              </div>
            </div>
            <div>
              <div class="text-2xl font-bold text-accent-400">{Object.keys(stats.byContinent).length}</div>
              <div class="text-xs text-primary-300 inline-flex items-center gap-1">
                覆盖大洲
                <button type="button" class="stat-info" aria-label="覆盖大洲口径：按大洲去重后的数量" title="口径：按大洲去重后的数量">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </button>
              </div>
            </div>
            <div>
              <div class="text-2xl font-bold text-accent-400">{Object.keys(stats.byRegion).length}</div>
              <div class="text-xs text-primary-300 inline-flex items-center gap-1">
                国家/地区
                <button type="button" class="stat-info" aria-label="国家/地区口径：按国家或地区去重后的数量" title="口径：按国家/地区去重后的数量">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </button>
              </div>
            </div>
            <div>
              <div class="text-2xl font-bold text-accent-400">{stats.avgDifficulty}</div>
              <div class="text-xs text-primary-300 inline-flex items-center gap-1">
                平均难度
                <button type="button" class="stat-info" aria-label="平均难度口径：全部案件综合难度的算术平均值，保留1位小数，范围0到5" title="口径：全部案件综合难度的算术平均值，保留1位小数，范围0–5">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </button>
              </div>
            </div>
          </div>
          {latestDate && <p class="text-xs text-primary-300/80 mt-3">数据更新至 {latestDate}</p>}
        </div>

        <!-- 右侧：案件速览（首屏内容锚点，填补留白） -->
        <aside class="w-full lg:w-[320px] lg:flex-shrink-0" aria-label="案件速览">
          <div class="bg-white/10 rounded-2xl border border-white/15 p-4 backdrop-blur-sm">
            <div class="flex items-center justify-between mb-3">
              <h2 class="text-white font-semibold">案件速览</h2>
              <button id="hero-shuffle" type="button" class="text-primary-200 hover:text-white text-sm inline-flex items-center gap-1 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                换一批
              </button>
            </div>
            <ul id="hero-pick-list" class="flex flex-col gap-2 mb-3">
              {heroPicks.map((c) => (
                <li>
                  <a href={`/fun_detective/case/${c.slug}`} class="hero-pick group flex items-center justify-between gap-3 rounded-lg px-3 py-2 hover:bg-white/10 transition-colors">
                    <span class="min-w-0">
                      <span class="block text-sm font-medium text-white truncate group-hover:text-accent-300 transition-colors">{c.基本信息.案件名称}</span>
                      <span class="block text-xs text-primary-300 mt-0.5">{c.sourceType} · {c.region}</span>
                    </span>
                    <span class="text-xs text-accent-300 flex-shrink-0">难度 {(c.设计视图.难度评分?.综合 || 0).toFixed(1)}</span>
                  </a>
                </li>
              ))}
            </ul>
            <a href="#case-grid" class="block text-center text-sm text-primary-100 border border-white/20 rounded-lg py-2 hover:bg-white/10 transition-colors">
              浏览全部 {stats.total} 件案件 ↓
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- 搜索和筛选 -->
  <section class="py-8 bg-white border-b border-stone-200 sticky top-16 z-40">
    <div class="container-page">
      <div class="flex flex-col md:flex-row gap-4">
        <!-- 搜索框 -->
        <div class="flex-1 relative">
          <label for="search-input" class="sr-only">搜索案件名称、简介或诡计</label>
          <input
            type="text"
            id="search-input"
            placeholder="搜索案件名称、简介、诡计...（支持模糊匹配）"
            class="input pl-10"
            aria-describedby="search-live"
          />
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-stone-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <!-- 筛选器 -->
        <div class="flex flex-wrap gap-3 items-center">
          <label class="sr-only" for="filter-source">按类型筛选</label>
          <select id="filter-source" class="input w-auto">
            <option value="">全部类型</option>
            {sourceTypes.map((type) => <option value={type}>{type}</option>)}
          </select>

          <!-- 自定义二级下拉菜单：地区→国家 -->
          <div class="region-dropdown" id="region-dropdown">
            <button
              type="button"
              class="input w-auto flex items-center justify-between gap-2 cursor-pointer"
              id="region-trigger"
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="region-menu"
            >
              <span id="region-trigger-text">全部地区</span>
              <svg class="w-4 h-4 text-stone-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div class="region-menu" id="region-menu" role="menu" aria-label="按大洲或国家筛选">
              <!-- 全部地区 -->
              <div class="region-menu-item" role="menuitem" tabindex="-1" data-region="" data-continent="">
                <span>全部地区</span>
              </div>
              <!-- 各地区分组 -->
              {continents.map((continent) => {
                const countries = continentCountries[continent] || [];
                const hasChildren = countries.length > 0;
                return (
                  <div class={`region-menu-item ${hasChildren ? 'has-children' : ''}`} role="menuitem" tabindex="-1" data-continent={continent} aria-haspopup={hasChildren ? 'true' : 'false'}>
                    <span class="region-menu-label">{continent}</span>
                    {hasChildren && (
                      <>
                        <svg class="w-4 h-4 text-stone-400 ml-auto flex-shrink-0 submenu-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                        <div class="region-submenu" role="menu" aria-label={`${continent}下的国家`}>
                          <div class="region-submenu-title">{continent} · 全部国家</div>
                          <div class="region-submenu-item" role="menuitem" tabindex="-1" data-region="" data-continent={continent}>
                            全部国家
                          </div>
                          {countries.map((country) => (
                            <div class="region-submenu-item" role="menuitem" tabindex="-1" data-region={country} data-continent={continent}>
                              {country}
                            </div>
                          ))}
                        </div>
                      </>
                    )}
                  </div>
                );
              })}
            </div>
          </div>

          <!-- 年代筛选 -->
          <label class="sr-only" for="filter-year">按年代筛选</label>
          <select id="filter-year" class="input w-auto">
            <option value="">全部年代</option>
            <option value="1800-1899">19世纪</option>
            <option value="1900-1949">1900-1949</option>
            <option value="1950-1979">1950-1979</option>
            <option value="1980-1999">1980-1999</option>
            <option value="2000-2009">2000-2009</option>
            <option value="2010-2019">2010-2019</option>
            <option value="2020-2099">2020年后</option>
          </select>

          <label class="sr-only" for="filter-sort">排序方式</label>
          <select id="filter-sort" class="input w-auto">
            <option value="date">最新录入</option>
            <option value="year-desc">发表时间（新→旧）</option>
            <option value="year-asc">发表时间（旧→新）</option>
            <option value="name">名称排序</option>
            <option value="difficulty-desc">难度从高到低</option>
            <option value="difficulty-asc">难度从低到高</option>
          </select>
        </div>
      </div>
    </div>
  </section>

  <!-- 案件列表 -->
  <section class="py-8">
    <div class="container-page">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-bold">全部案件</h2>
        <span id="result-count" class="text-stone-500 text-sm" aria-live="off">共 {cases.length} 条</span>
      </div>
      <div id="case-grid" class="case-masonry">
        {cases.map((caseData) => (
          <CaseCard caseData={caseData} />
        ))}
      </div>
      <div id="no-results" class="hidden text-center py-16">
        <svg class="w-16 h-16 mx-auto text-stone-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="text-stone-500">没有找到匹配的案件</p>
      </div>
      <!-- 加载更多按钮（JS禁用时的降级方案） -->
      <div id="load-more-container" class="text-center mt-6">
        <button id="load-more-btn" class="btn btn-primary">
          加载更多
        </button>
      </div>
      <!-- 无限滚动哨兵元素 -->
      <div id="scroll-sentinel" class="h-1" aria-hidden="true"></div>
      <!-- 全部加载完成提示 -->
      <div id="all-loaded" class="hidden text-center py-6 text-sm text-stone-400">
        已加载全部案件
      </div>
      <!-- 屏幕阅读器结果播报 -->
      <div id="search-live" class="sr-only" role="status" aria-live="polite"></div>
    </div>
  </section>

  <!-- 回到顶部按钮 -->
  <button id="back-to-top" type="button" aria-label="回到顶部" class="back-to-top">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
    </svg>
  </button>

  <style>
    /* 案件网格：按行填充的grid布局，避免少量结果时整列空白 */
    .case-masonry {
      display: grid;
      grid-template-columns: 1fr;
      gap: 20px;
    }
    @media (min-width: 768px) {
      .case-masonry {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (min-width: 1024px) {
      .case-masonry {
        grid-template-columns: repeat(3, 1fr);
      }
    }
    .case-masonry > article {
      width: 100%;
    }

    /* 回到顶部按钮 */
    .back-to-top {
      position: fixed;
      bottom: 24px;
      right: 24px;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: #4338ca;
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 12px rgba(67, 56, 202, 0.4);
      opacity: 0;
      visibility: hidden;
      transform: translateY(10px);
      transition: all 0.2s ease;
      z-index: 40;
      cursor: pointer;
      border: none;
    }
    .back-to-top.visible {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    .back-to-top:hover {
      background: #3730a3;
      transform: translateY(-2px);
    }
    .back-to-top:focus-visible {
      outline: 2px solid #6366f1;
      outline-offset: 2px;
    }

    /* 统计口径提示按钮 */
    .stat-info {
      display: inline-flex;
      align-items: center;
      color: rgba(199, 210, 254, 0.7);
      transition: color 0.15s;
    }
    .stat-info:hover,
    .stat-info:focus-visible {
      color: #fff;
      outline: none;
    }
    /* Hero 速览条目 */
    .hero-pick {
      outline-offset: 2px;
    }
    .hero-pick:focus-visible {
      outline: 2px solid #fbbf24;
    }

    /* 二级下拉菜单样式 */
    .region-dropdown {
      position: relative;
    }
    .region-menu {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      margin-top: 4px;
      background: white;
      border: 1px solid #e7e5e4;
      border-radius: 8px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.1);
      min-width: 160px;
      z-index: 50;
      padding: 4px 0;
    }
    .region-dropdown.open .region-menu {
      display: block;
    }
    .region-menu-item {
      display: flex;
      align-items: center;
      padding: 8px 14px;
      cursor: pointer;
      font-size: 14px;
      color: #44403c;
      position: relative;
      transition: background 0.15s;
      user-select: none;
    }
    .region-menu-item:hover,
    .region-menu-item.keyboard-focus,
    .region-submenu-item:hover,
    .region-submenu-item.keyboard-focus {
      background: #f5f5f4;
    }
    .region-menu-item.has-children:hover {
      background: #f5f5f4;
    }
    .region-menu-item:focus,
    .region-submenu-item:focus {
      outline: none;
      background: #eef2ff;
    }
    .region-menu-label {
      flex: 1;
    }
    /* 二级子菜单：PC端hover显示 */
    .region-submenu {
      display: none;
      position: absolute;
      left: 100%;
      top: -4px;
      margin-left: 2px;
      background: white;
      border: 1px solid #e7e5e4;
      border-radius: 8px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.1);
      min-width: 140px;
      z-index: 51;
      padding: 4px 0;
    }
    .region-menu-item.has-children:hover > .region-submenu,
    .region-menu-item.has-children.open-kbd > .region-submenu {
      display: block;
    }
    .region-submenu-title {
      padding: 6px 14px;
      font-size: 12px;
      color: #a8a29e;
      border-bottom: 1px solid #f5f5f4;
      margin-bottom: 2px;
    }
    .region-submenu-item {
      padding: 8px 14px;
      cursor: pointer;
      font-size: 14px;
      color: #44403c;
      transition: background 0.15s;
      user-select: none;
    }
    .region-submenu-item:hover {
      color: #1c1917;
    }
    /* 移动端：点击展开二级 */
    @media (max-width: 768px) {
      .region-menu-item.has-children.open-submenu > .region-submenu {
        display: block;
        position: static;
        margin-left: 0;
        margin-top: 4px;
        box-shadow: none;
        border: none;
        background: #fafaf9;
        border-radius: 4px;
      }
      .region-menu-item.has-children.open-submenu .submenu-arrow {
        transform: rotate(90deg);
      }
      .submenu-arrow {
        transition: transform 0.2s;
      }
    }
  </style>

  <script>
    import { initCaseBrowser } from '../scripts/case-browser';

    // ===== 元素引用 =====
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const filterSource = document.getElementById('filter-source') as HTMLSelectElement;
    const filterSort = document.getElementById('filter-sort') as HTMLSelectElement;
    const filterYear = document.getElementById('filter-year') as HTMLSelectElement;
    const caseGrid = document.getElementById('case-grid')!;
    const noResults = document.getElementById('no-results')!;
    const resultCount = document.getElementById('result-count')!;
    const loadMoreBtn = document.getElementById('load-more-btn') as HTMLButtonElement;
    const loadMoreContainer = document.getElementById('load-more-container')!;
    const liveRegion = document.getElementById('search-live')!;

    const regionDropdown = document.getElementById('region-dropdown')!;
    const regionTrigger = document.getElementById('region-trigger') as HTMLButtonElement;
    const regionTriggerText = document.getElementById('region-trigger-text')!;
    const regionMenu = document.getElementById('region-menu')!;

    // 当前选中的筛选值
    let selectedRegion = '';
    let selectedContinent = '';

    // 初始化时从 URL 恢复地区选择
    const initParams = new URLSearchParams(window.location.search);
    selectedRegion = initParams.get('region') || '';
    selectedContinent = initParams.get('continent') || '';

    const isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0;

    // ===== 二级下拉菜单逻辑（含完整键盘契约） =====
    function setOpen(open: boolean) {
      regionDropdown.classList.toggle('open', open);
      regionTrigger.setAttribute('aria-expanded', String(open));
      if (!open) {
        regionMenu.querySelectorAll('.has-children.open-submenu,.has-children.open-kbd').forEach((el) => {
          el.classList.remove('open-submenu', 'open-kbd');
        });
      }
    }
    function toggleDropdown(open?: boolean) {
      const shouldOpen = open !== undefined ? open : !regionDropdown.classList.contains('open');
      setOpen(shouldOpen);
    }

    function updateTriggerText() {
      if (selectedRegion) {
        regionTriggerText.textContent = selectedRegion;
      } else if (selectedContinent) {
        regionTriggerText.textContent = `${selectedContinent} · 全部`;
      } else {
        regionTriggerText.textContent = '全部地区';
      }
    }

    // 把地区选择写入 URL（保留 q/source/sort/page 等其他参数）
    function writeRegionToUrl() {
      const params = new URLSearchParams(window.location.search);
      if (selectedContinent) params.set('continent', selectedContinent);
      else params.delete('continent');
      if (selectedRegion) params.set('region', selectedRegion);
      else params.delete('region');
      params.delete('page');
      const qs = params.toString();
      window.history.replaceState(null, '', window.location.pathname + (qs ? `?${qs}` : ''));
    }

    function selectRegion(region: string, continent: string) {
      selectedRegion = region;
      selectedContinent = continent;
      updateTriggerText();
      setOpen(false);
      writeRegionToUrl();
      browser.refresh();
      regionTrigger.focus();
    }

    // 键盘导航：收集当前可聚焦的菜单项
    function visibleItems(): HTMLElement[] {
      const items: HTMLElement[] = [];
      regionMenu.querySelectorAll<HTMLElement>('.region-menu-item, .region-submenu-item').forEach((el) => {
        const sub = el.closest('.region-submenu');
        if (sub) {
          const parent = sub.parentElement!;
          // 子菜单仅在父级展开（PC hover/kbd 或移动端 open-submenu）时可聚焦
          const expanded = parent.classList.contains('open-kbd') || parent.classList.contains('open-submenu')
            || parent.matches(':hover');
          if (expanded) items.push(el);
        } else {
          items.push(el);
        }
      });
      return items;
    }
    function focusItem(el: HTMLElement | null | undefined) {
      if (!el) return;
      el.focus();
    }

    function activateItem(el: HTMLElement) {
      if (el.classList.contains('region-submenu-item')) {
        selectRegion(el.dataset.region || '', el.dataset.continent || '');
        return;
      }
      const hasChildren = el.classList.contains('has-children');
      if (isTouchDevice && hasChildren) {
        el.classList.toggle('open-submenu');
      } else if (!hasChildren) {
        selectRegion(el.dataset.region || '', el.dataset.continent || '');
      } else {
        el.classList.add('open-kbd');
      }
    }

    regionTrigger.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleDropdown();
    });
    regionTrigger.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        if (!regionDropdown.classList.contains('open')) setOpen(true);
        focusItem(visibleItems()[0]);
      }
    });

    regionMenu.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const submenuItem = target.closest('.region-submenu-item') as HTMLElement | null;
      if (submenuItem) {
        e.stopPropagation();
        selectRegion(submenuItem.dataset.region || '', submenuItem.dataset.continent || '');
        return;
      }
      const menuItem = target.closest('.region-menu-item') as HTMLElement | null;
      if (menuItem) {
        e.stopPropagation();
        activateItem(menuItem);
      }
    });

    regionMenu.addEventListener('keydown', (e) => {
      const current = document.activeElement as HTMLElement;
      const items = visibleItems();
      const idx = items.indexOf(current);
      switch (e.key) {
        case 'ArrowDown':
          e.preventDefault();
          focusItem(items[(idx + 1 + items.length) % items.length]);
          break;
        case 'ArrowUp':
          e.preventDefault();
          focusItem(items[(idx - 1 + items.length) % items.length]);
          break;
        case 'ArrowRight': {
          const parent = current.classList.contains('region-menu-item') ? current : current.closest('.has-children') as HTMLElement | null;
          if (parent?.classList.contains('has-children')) {
            e.preventDefault();
            parent.classList.add('open-kbd', 'open-submenu');
            focusItem(parent.querySelector('.region-submenu-item') as HTMLElement);
          }
          break;
        }
        case 'ArrowLeft': {
          const sub = current.closest('.region-submenu');
          if (sub) {
            e.preventDefault();
            const parent = sub.parentElement!;
            parent.classList.remove('open-kbd');
            focusItem(parent);
          }
          break;
        }
        case 'Enter':
        case ' ':
          e.preventDefault();
          activateItem(current);
          break;
        case 'Escape':
          e.preventDefault();
          setOpen(false);
          regionTrigger.focus();
          break;
        case 'Tab':
          setOpen(false);
          break;
      }
    });

    document.addEventListener('click', (e) => {
      if (!regionDropdown.contains(e.target as Node)) setOpen(false);
    });

    // ===== 列表浏览（搜索/筛选/排序/分页/URL同步/加载反馈） =====
    const browser = initCaseBrowser({
      grid: caseGrid,
      search: searchInput,
      source: filterSource,
      sort: filterSort,
      loadMoreBtn,
      loadMoreContainer,
      count: resultCount,
      noResults,
      live: liveRegion,
      pageSize: 50,
      syncUrl: true,
      extraFilter: (item) => {
        const matchRegion = !selectedRegion || item.region === selectedRegion;
        const matchContinent = !selectedContinent || selectedRegion || item.continent === selectedContinent;
        // 年份范围筛选
        let matchYear = true;
        const yearVal = filterYear.value;
        if (yearVal && item.year) {
          const [min, max] = yearVal.split('-').map(Number);
          matchYear = item.year >= min && item.year <= max;
        } else if (yearVal && !item.year) {
          matchYear = false;
        }
        return matchRegion && matchContinent && matchYear;
      },
    });

    // 年代筛选变化时触发重新筛选
    filterYear.addEventListener('change', () => {
      browser.refresh();
    });

    updateTriggerText();

    // ===== 无限滚动 =====
    const sentinel = document.getElementById('scroll-sentinel');
    const allLoaded = document.getElementById('all-loaded');
    if (sentinel && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          const loadBtn = document.getElementById('load-more-btn') as HTMLButtonElement | null;
          const container = document.getElementById('load-more-container');
          if (loadBtn && !loadBtn.disabled && container && !container.classList.contains('hidden')) {
            loadBtn.click();
          }
        }
      }, { rootMargin: '300px' });
      observer.observe(sentinel);
    }

    // 监听加载更多容器状态，全部加载完显示提示
    const loadContainer = document.getElementById('load-more-container');
    if (loadContainer && allLoaded) {
      const observer = new MutationObserver(() => {
        if (loadContainer.classList.contains('hidden')) {
          allLoaded.classList.remove('hidden');
        } else {
          allLoaded.classList.add('hidden');
        }
      });
      observer.observe(loadContainer, { attributes: true, attributeFilter: ['class'] });
    }

    // ===== 回到顶部 =====
    const backToTop = document.getElementById('back-to-top');
    if (backToTop) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 500) {
          backToTop.classList.add('visible');
        } else {
          backToTop.classList.remove('visible');
        }
      }, { passive: true });
      backToTop.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // ===== Hero「换一批」 =====
    const pickList = document.getElementById('hero-pick-list');
    const shuffleBtn = document.getElementById('hero-shuffle');
    if (pickList && shuffleBtn) {
      const pickData: Array<{ slug: string; name: string; source: string; region: string; difficulty: string }> = JSON.parse(
        document.getElementById('hero-pick-data')?.textContent || '[]',
      );
      let pickCursor = 3;
      shuffleBtn.addEventListener('click', () => {
        if (pickData.length === 0) return;
        const frag = document.createDocumentFragment();
        for (let i = 0; i < Math.min(3, pickData.length); i++) {
          const c = pickData[(pickCursor + i) % pickData.length];
          const li = document.createElement('li');
          li.innerHTML = `<a href="${c.slug}" class="hero-pick group flex items-center justify-between gap-3 rounded-lg px-3 py-2.5 hover:bg-white/10 transition-colors">
            <span class="min-w-0"><span class="block text-sm font-medium text-white truncate">${c.name}</span>
            <span class="block text-xs text-primary-300 mt-0.5">${c.source} · ${c.region}</span></span>
            <span class="text-xs text-accent-300 flex-shrink-0">难度 ${c.difficulty}</span></a>`;
          frag.appendChild(li);
        }
        pickList.replaceChildren(frag);
        pickCursor = (pickCursor + 3) % pickData.length;
      });
    }
  </script>
  <script type="application/json" id="hero-pick-data" set:html={JSON.stringify(pickData)} />
</BaseLayout>
