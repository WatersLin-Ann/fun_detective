---
import BaseLayout from '@layouts/BaseLayout.astro';
import CaseCard from '@components/CaseCard.astro';
import { loadAllCases, getStats, getSourceTypes, getContinents, getRegionsByContinent } from '@lib/caseLoader';

const cases = loadAllCases();
const stats = getStats();
const sourceTypes = getSourceTypes();
const continents = getContinents();
const continentCountries: Record<string, string[]> = {};
for (const continent of continents) {
  continentCountries[continent] = getRegionsByContinent(continent);
}
const PAGE_SIZE = 50;
const orderedPicks = [...cases].sort((a, b) => a.slug.localeCompare(b.slug, 'zh-CN'));
const now = new Date();
const dayOfYear = Math.floor((now.getTime() - new Date(now.getFullYear(), 0, 0).getTime()) / 86400000);
const pickOffset = orderedPicks.length > 0 ? dayOfYear % orderedPicks.length : 0;
const heroPicks = [0, 1, 2].map((i) => orderedPicks[(pickOffset + i) % Math.max(orderedPicks.length, 1)]).filter(Boolean);
const pickData = orderedPicks.map((c) => ({ slug: `/fun_detective/case/${c.slug}`, name: c.基本信息.案件名称, source: c.sourceType, region: c.region, difficulty: (c.设计视图.难度评分?.综合 || 0).toFixed(1) }));
const latestDate = cases.map((c) => c.元数据?.录入日期 || '').sort().pop() || '';
---
<BaseLayout title="首页" description="全球虚拟真实案件案例库">
  <section class="bg-gradient-to-br from-primary-950 via-primary-900 to-primary-800 text-white py-8">
    <div class="container-page">
      <div class="flex flex-col lg:flex-row gap-6 lg:gap-10 items-center">
        <div class="flex-1 min-w-0 w-full">
          <h1 class="text-2xl md:text-3xl font-bold mb-3">探索全球<span class="text-accent-400">经典案件</span>的诡计与叙事</h1>
          <p class="text-base text-primary-200 mb-5 max-w-2xl">汇集推理小说、真实案件、影视游戏中的经典案例，为推理爱好者和创作者提供结构化的案件参考与延伸阅读指引。</p>
          <div class="flex flex-wrap gap-x-6 gap-y-2">
            <div><div class="text-2xl font-bold text-accent-400">{stats.total}</div><div class="text-xs text-primary-300">案件总数</div></div>
            <div><div class="text-2xl font-bold text-accent-400">{Object.keys(stats.bySourceType).length}</div><div class="text-xs text-primary-300">来源类型</div></div>
            <div><div class="text-2xl font-bold text-accent-400">{Object.keys(stats.byContinent).length}</div><div class="text-xs text-primary-300">覆盖大洲</div></div>
            <div><div class="text-2xl font-bold text-accent-400">{Object.keys(stats.byRegion).length}</div><div class="text-xs text-primary-300">国家/地区</div></div>
            <div><div class="text-2xl font-bold text-accent-400">{stats.avgDifficulty}</div><div class="text-xs text-primary-300">平均难度</div></div>
          </div>
          {latestDate && <p class="text-xs text-primary-300/80 mt-3">数据更新至 {latestDate}</p>}
        </div>
        <aside class="w-full lg:w-[320px] lg:flex-shrink-0">
          <div class="bg-white/10 rounded-2xl border border-white/15 p-4 backdrop-blur-sm">
            <div class="flex items-center justify-between mb-3">
              <h2 class="text-white font-semibold">案件速览</h2>
              <button id="hero-shuffle" type="button" class="text-primary-200 hover:text-white text-sm">换一批</button>
            </div>
            <ul id="hero-pick-list" class="flex flex-col gap-2 mb-3">
              {heroPicks.map((c) => (<li><a href={`/fun_detective/case/${c.slug}`} class="hero-pick group flex items-center justify-between gap-3 rounded-lg px-3 py-2 hover:bg-white/10"><span class="min-w-0"><span class="block text-sm font-medium text-white truncate">{c.基本信息.案件名称}</span><span class="block text-xs text-primary-300 mt-0.5">{c.sourceType} · {c.region}</span></span><span class="text-xs text-accent-300">难度 {(c.设计视图.难度评分?.综合 || 0).toFixed(1)}</span></a></li>))}
            </ul>
            <a href="#case-grid" class="block text-center text-sm text-primary-100 border border-white/20 rounded-lg py-2 hover:bg-white/10">浏览全部 {stats.total} 件案件 ↓</a>
          </div>
        </aside>
      </div>
    </div>
  </section>
  <section class="py-8 bg-white border-b border-stone-200 sticky top-16 z-40">
    <div class="container-page">
      <div class="flex flex-col md:flex-row gap-4">
        <div class="flex-1 relative">
          <label for="search-input" class="sr-only">搜索案件</label>
          <input type="text" id="search-input" placeholder="搜索案件名称、简介、诡计..." class="input pl-10" />
        </div>
        <div class="flex flex-wrap gap-3 items-center">
          <select id="filter-source" class="input w-auto"><option value="">全部类型</option>{sourceTypes.map((type) => <option value={type}>{type}</option>)}</select>
          <select id="filter-year" class="input w-auto"><option value="">全部年代</option><option value="1800-1899">19世纪</option><option value="1900-1949">1900-1949</option><option value="1950-1979">1950-1979</option><option value="1980-1999">1980-1999</option><option value="2000-2009">2000-2009</option><option value="2010-2019">2010-2019</option><option value="2020-2099">2020年后</option></select>
          <select id="filter-sort" class="input w-auto"><option value="date">最新录入</option><option value="year-desc">发表时间（新→旧）</option><option value="year-asc">发表时间（旧→新）</option><option value="name">名称排序</option><option value="difficulty-desc">难度从高到低</option><option value="difficulty-asc">难度从低到高</option></select>
        </div>
      </div>
    </div>
  </section>
  <section class="py-8">
    <div class="container-page">
      <div class="flex items-center justify-between mb-4"><h2 class="text-xl font-bold">全部案件</h2><span id="result-count" class="text-stone-500 text-sm">共 {cases.length} 条</span></div>
      <div id="case-grid" class="case-masonry">{cases.map((caseData) => (<CaseCard caseData={caseData} />))}</div>
      <div id="no-results" class="hidden text-center py-16"><p class="text-stone-500">没有找到匹配的案件</p></div>
      <div id="load-more-container" class="text-center mt-6"><button id="load-more-btn" class="btn btn-primary">加载更多</button></div>
      <div id="scroll-sentinel" class="h-1"></div>
      <div id="all-loaded" class="hidden text-center py-6 text-sm text-stone-400">已加载全部案件</div>
      <div id="search-live" class="sr-only" role="status" aria-live="polite"></div>
    </div>
  </section>
  <button id="back-to-top" type="button" aria-label="回到顶部" class="back-to-top">↑</button>
  <style>
    .case-masonry { column-count: 1; column-gap: 16px; }
    @media (min-width: 768px) { .case-masonry { column-count: 2; } }
    @media (min-width: 1024px) { .case-masonry { column-count: 3; } }
    .case-masonry > article { break-inside: avoid; margin-bottom: 16px; display: inline-block; width: 100%; }
    .back-to-top { position: fixed; bottom: 24px; right: 24px; width: 44px; height: 44px; border-radius: 50%; background: #4338ca; color: white; display: flex; align-items: center; justify-content: center; opacity: 0; visibility: hidden; transition: all 0.2s; z-index: 40; cursor: pointer; border: none; }
    .back-to-top.visible { opacity: 1; visibility: visible; }
  </style>
  <script>
    import { initCaseBrowser } from '../scripts/case-browser';
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const filterSource = document.getElementById('filter-source') as HTMLSelectElement;
    const filterYear = document.getElementById('filter-year') as HTMLSelectElement;
    const filterSort = document.getElementById('filter-sort') as HTMLSelectElement;
    const caseGrid = document.getElementById('case-grid')!;
    const noResults = document.getElementById('no-results')!;
    const resultCount = document.getElementById('result-count')!;
    const loadMoreBtn = document.getElementById('load-more-btn') as HTMLButtonElement;
    const loadMoreContainer = document.getElementById('load-more-container')!;
    const liveRegion = document.getElementById('search-live')!;
    let selectedYear = '';
    const initParams = new URLSearchParams(window.location.search);
    selectedYear = initParams.get('year') || '';
    if (filterYear && selectedYear) filterYear.value = selectedYear;
    if (filterYear) {
      filterYear.addEventListener('change', () => {
        selectedYear = filterYear.value;
        const params = new URLSearchParams(window.location.search);
        if (selectedYear) params.set('year', selectedYear); else params.delete('year');
        params.delete('page');
        window.history.replaceState(null, '', window.location.pathname + (params.toString() ? `?${params.toString()}` : ''));
        browser.refresh();
      });
    }
    const browser = initCaseBrowser({
      grid: caseGrid, search: searchInput, source: filterSource, sort: filterSort,
      loadMoreBtn, loadMoreContainer, count: resultCount, noResults, live: liveRegion,
      pageSize: 50, syncUrl: true,
      extraFilter: (item) => {
        let matchYear = true;
        if (selectedYear) {
          const [minY, maxY] = selectedYear.split('-').map(Number);
          const year = (item as any).year || 0;
          matchYear = year >= minY && year <= maxY;
        }
        return matchYear;
      },
    });
    const sentinel = document.getElementById('scroll-sentinel');
    const allLoaded = document.getElementById('all-loaded');
    if (sentinel && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) {
          const loadBtn = document.getElementById('load-more-btn') as HTMLButtonElement | null;
          const container = document.getElementById('load-more-container');
          if (loadBtn && !loadBtn.disabled && container && !container.classList.contains('hidden')) loadBtn.click();
        }
      }, { rootMargin: '300px' });
      observer.observe(sentinel);
    }
    const backToTop = document.getElementById('back-to-top');
    if (backToTop) {
      window.addEventListener('scroll', () => { backToTop.classList.toggle('visible', window.scrollY > 500); }, { passive: true });
      backToTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    }
  </script>
  <script type="application/json" id="hero-pick-data" set:html={JSON.stringify(pickData)} />
</BaseLayout>