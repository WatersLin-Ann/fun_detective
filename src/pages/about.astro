---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getStats } from '@lib/caseLoader';
import pkg from '../../package.json';

const stats = getStats();
// 技术栈版本构建时从 package.json 读取，避免手写版本与实际依赖漂移
const astroMajor = String(pkg.dependencies.astro).replace(/^[\^~]/, '').split('.')[0];
---

<BaseLayout title="关于" description="关于 Fun Detective 项目">
  <section class="py-12">
    <div class="container-page max-w-3xl">
      <h1 class="text-3xl font-bold mb-6">关于 Fun Detective</h1>

      <div class="prose max-w-none">
        <p class="text-lg text-stone-700 mb-6">
          Fun Detective 是一个全球虚拟真实案件案例库，汇集推理小说、真实案件、影视游戏中的经典案例，
          为小说创作和游戏设计提供结构化的灵感与参考。
        </p>

        <h2 class="text-xl font-bold mt-8 mb-4">项目目标</h2>
        <ul class="space-y-2 text-stone-700">
          <li>📚 <strong>小说/短文阅读</strong>：结构化呈现案件故事，支持故事视图阅读</li>
          <li>🎮 <strong>游戏设计支持</strong>：提取诡计、机制、信息差等设计要素，支持游戏设计视图</li>
          <li>🔍 <strong>创作灵感库</strong>：按类型、地区、难度筛选，快速找到参考案例</li>
        </ul>

        <h2 class="text-xl font-bold mt-8 mb-4">数据来源</h2>
        <p class="text-stone-700 mb-4">
          案件数据维护在飞书多维表格中，通过自动化脚本同步至 GitHub 仓库，
          再由 Astro 静态生成网站。
        </p>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 my-8">
          <div class="card p-4 text-center">
            <div class="text-2xl font-bold text-primary-700">{stats.total}</div>
            <div class="text-sm text-stone-500" title="口径：库内全部案件条目数，按条目去重">案件总数</div>
          </div>
          <div class="card p-4 text-center">
            <div class="text-2xl font-bold text-primary-700">{Object.keys(stats.bySourceType).length}</div>
            <div class="text-sm text-stone-500" title="口径：按来源类型去重后的数量">来源类型</div>
          </div>
          <div class="card p-4 text-center">
            <div class="text-2xl font-bold text-primary-700">{Object.keys(stats.byRegion).length}</div>
            <div class="text-sm text-stone-500" title="口径：按国家/地区去重后的数量">覆盖地区</div>
          </div>
          <div class="card p-4 text-center">
            <div class="text-2xl font-bold text-accent-600">{stats.avgDifficulty}</div>
            <div class="text-sm text-stone-500" title="口径：全部案件综合难度的算术平均值，保留1位小数，范围0–5">平均难度</div>
          </div>
        </div>

        <h2 class="text-xl font-bold mt-8 mb-4">技术栈</h2>
        <ul class="space-y-2 text-stone-700">
          <li>前端框架：Astro {astroMajor} + TypeScript（版本构建时自动读取 package.json）</li>
          <li>样式：Tailwind CSS</li>
          <li>数据：飞书多维表格 → GitHub JSON</li>
          <li>部署：GitHub Pages</li>
        </ul>

        <h2 class="text-xl font-bold mt-8 mb-4">数据声明</h2>
        <p class="text-stone-700">
          本项目案件数据仅供学习和创作参考，真实案件相关内容基于公开资料整理，
          不代表任何官方立场。虚构作品相关内容版权归原作者所有。
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
