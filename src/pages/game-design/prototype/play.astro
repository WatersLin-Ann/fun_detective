---
import BaseLayout from '@layouts/BaseLayout.astro';
import GameScene from '@components/prototype/GameScene.astro';
import EvidenceBar from '@components/prototype/EvidenceBar.astro';
import DialogBox from '@components/prototype/DialogBox.astro';
import TrialPanel from '@components/prototype/TrialPanel.astro';
import { gameScenes, gameEvidence, gameWitnesses, gameDialogs } from '@data/prototype-orient-express';
---

<BaseLayout title="东方快车：推理审判" description="可交互推理游戏原型">
  <div class="min-h-screen bg-stone-900 text-white">
    <!-- 游戏顶部栏 -->
    <div class="bg-stone-800 p-3 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/fun_detective/game-design/prototype" class="text-stone-400 hover:text-white text-sm">← 返回</a>
        <span class="font-bold">东方快车：推理审判</span>
      </div>
      <div class="flex items-center gap-4 text-sm">
        <span id="phase-indicator" class="text-stone-300">开场</span>
        <span id="confidence-display" class="text-stone-300">信心值: 100</span>
        <button id="evidence-btn" class="px-3 py-1 bg-stone-700 rounded hover:bg-stone-600">
          证据 (<span id="evidence-count">0</span>)
        </button>
        <button onclick="NotebookUI.open()" class="px-3 py-1 bg-amber-700 rounded hover:bg-amber-600 text-xs">
          📝 笔记
        </button>
        <button id="reset-btn" class="px-3 py-1 bg-red-800 rounded hover:bg-red-700 text-xs">重置</button>
      </div>
    </div>

    <!-- 游戏主区域 -->
    <div class="container-page py-6 pb-32">
      <!-- 开场/对话阶段 -->
      <div id="intro-section" class="max-w-2xl mx-auto">
        <div class="bg-stone-800 rounded-xl p-8 min-h-64 flex flex-col justify-between">
          <div id="intro-text" class="text-lg leading-relaxed text-stone-200"></div>
          <button id="intro-continue" class="mt-6 self-end px-6 py-2 bg-primary-600 rounded-lg hover:bg-primary-700">
            继续
          </button>
        </div>
      </div>

      <!-- 调查阶段 -->
      <div id="investigation-section" class="hidden">
        <div class="mb-4">
          <h2 class="text-xl font-bold mb-2">🔍 调查阶段</h2>
          <p class="text-sm text-stone-400">点击场景中的物品和人物进行互动。收集至少3件证据、询问至少3个证人后，可前往餐车进行审判。</p>
          <div class="mt-2 flex gap-4 text-sm">
            <span>已收集证据: <span id="inv-evidence-count" class="text-accent-400 font-bold">0</span>/3</span>
            <span>已询问证人: <span id="inv-witness-count" class="text-accent-400 font-bold">0</span>/3</span>
          </div>
        </div>
        <div id="game-scene-container"></div>
      </div>

      <!-- 审判阶段 -->
      <div id="trial-section" class="hidden max-w-4xl mx-auto">
        <div id="trial-panel-container"></div>
        <div id="trial-dialog-container" class="mt-6"></div>
      </div>

      <!-- 结局阶段 -->
      <div id="ending-section" class="hidden max-w-2xl mx-auto">
        <div class="bg-stone-800 rounded-xl p-8">
          <h2 id="ending-title" class="text-3xl font-bold mb-4 text-center"></h2>
          <p id="ending-description" class="text-lg leading-relaxed text-stone-300 mb-6"></p>
          <div id="ending-stats" class="bg-stone-700 rounded-lg p-4 mb-6">
            <h3 class="font-bold mb-2">游戏统计</h3>
            <div class="grid grid-cols-2 gap-2 text-sm">
              <div>收集证据: <span id="stat-evidence"></span></div>
              <div>询问证人: <span id="stat-witness"></span></div>
              <div>揭露矛盾: <span id="stat-contradiction"></span></div>
              <div>最终信心值: <span id="stat-confidence"></span></div>
            </div>
          </div>
          <div class="flex gap-4 justify-center">
            <button id="ending-restart" class="px-6 py-2 bg-primary-600 rounded-lg hover:bg-primary-700">重新开始</button>
            <a href="/fun_detective/game-design" class="px-6 py-2 bg-stone-600 rounded-lg hover:bg-stone-500">返回游戏设计</a>
          </div>
        </div>
      </div>
    </div>

    <!-- 证据栏 -->
    <div id="evidence-bar-container"></div>

    <!-- 对话框 -->
    <div id="dialog-container"></div>
  </div>

  <!-- 引入游戏数据（必须在内联脚本之前加载） -->
  <script is:inline src="/fun_detective/game/data-orient-express.js"></script>
  <!-- 引入游戏UI工具模块 -->
  <script is:inline src="/fun_detective/game/ui.js"></script>
  <!-- 引入玩家数据与笔记系统 -->
  <script is:inline src="/fun_detective/game/playerData.js"></script>
  <script is:inline src="/fun_detective/game/notebookUI.js"></script>

  <script is:inline>
    // 游戏数据（从外部模块加载）
    const gameScenes = GameData.scenes;
    const gameEvidence = GameData.evidence;
    const gameWitnesses = GameData.witnesses;
    const gameDialogs = GameData.dialogs;
    const gameContradictions = GameData.contradictions;

        // 暴露游戏数据到全局，供笔记系统使用
    window._gameEvidence = gameEvidence;
    window._gameWitnesses = gameWitnesses;
    window._gameData = GameData;

    // 游戏状态
    let state = {
      currentScene: 'intro',
      gamePhase: 'intro',
      collectedEvidence: [],
      interviewedWitnesses: [],
      contradictionsFound: [],
      confidence: 100,
      choices: {},
      dialogIndex: 0,
      currentWitness: null,
      showEvidenceBar: false,
      selectedEvidence: null,
      evidenceMode: 'view',
      dialogueHistory: [],
      witnessReaction: 'normal',
      showHistory: false,
      isTransitioning: false,
    };

    // 初始化
    function init() {
      // 检查是否继续游戏
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('continue') === '1') {
        const saved = localStorage.getItem('fun-detective-prototype-save');
        if (saved) {
          state = JSON.parse(saved);
        }
      } else {
        localStorage.removeItem('fun-detective-prototype-save');
      }
      render();
    }

    // 保存
    function save() {
      localStorage.setItem('fun-detective-prototype-save', JSON.stringify(state));
    }

    // 渲染
    function render() {
      updateTopBar();
      
      // 隐藏所有阶段
      document.getElementById('intro-section').classList.add('hidden');
      document.getElementById('investigation-section').classList.add('hidden');
      document.getElementById('trial-section').classList.add('hidden');
      document.getElementById('ending-section').classList.add('hidden');

      if (state.gamePhase === 'intro') {
        renderIntro();
      } else if (state.gamePhase === 'investigation') {
        renderInvestigation();
      } else if (state.gamePhase === 'trial') {
        renderTrial();
      } else if (state.gamePhase === 'ending') {
        renderEnding();
      }

      renderEvidenceBar();
      save();
    }

    function updateTopBar() {
      const phaseNames = { intro: '开场', investigation: '调查', trial: '审判', ending: '结局' };
      document.getElementById('phase-indicator').textContent = phaseNames[state.gamePhase] || '';
      document.getElementById('confidence-display').textContent = `信心值: ${state.confidence}`;
      document.getElementById('evidence-count').textContent = state.collectedEvidence.length;
    }

    // 开场渲染
    function renderIntro() {
      document.getElementById('intro-section').classList.remove('hidden');
      const texts = state.dialogIndex < 6 ? gameDialogs.intro : gameDialogs.investigationStart;
      const idx = state.dialogIndex < 6 ? state.dialogIndex : state.dialogIndex - 6;
      document.getElementById('intro-text').textContent = texts[idx] || '';
      
      const btn = document.getElementById('intro-continue');
      if (state.dialogIndex >= 11) {
        btn.textContent = '开始调查';
      } else {
        btn.textContent = '继续';
      }
    }

    // 调查阶段渲染
    function renderInvestigation() {
      document.getElementById('investigation-section').classList.remove('hidden');
      document.getElementById('inv-evidence-count').textContent = state.collectedEvidence.length;
      document.getElementById('inv-witness-count').textContent = state.interviewedWitnesses.length;
      
      // 场景切换动画
      const sceneContainer = document.getElementById('game-scene-container');
      if (sceneContainer && !state.isTransitioning) {
        state.isTransitioning = true;
        sceneContainer.style.opacity = '0';
        sceneContainer.style.transform = 'translateY(10px)';
        sceneContainer.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
        setTimeout(() => {
          sceneContainer.style.opacity = '1';
          sceneContainer.style.transform = 'translateY(0)';
          state.isTransitioning = false;
        }, 50);
      }

      const scene = gameScenes.find(s => s.id === state.currentScene);
      if (!scene) return;

      const container = document.getElementById('game-scene-container');
      
      // 场景背景配置
      const sceneBgs = {
        train: 'linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%)',
        room: 'linear-gradient(180deg, #2d2d2d 0%, #3d3d3d 50%, #4a4a4a 100%)',
        corridor: 'linear-gradient(180deg, #1a1a1a 0%, #2a2a2a 50%, #333 100%)',
        dining: 'linear-gradient(180deg, #3d2914 0%, #5c3d1e 50%, #7a5230 100%)',
        outdoor: 'linear-gradient(180deg, #87ceeb 0%, #98d8c8 50%, #f7dc6f 100%)',
        office: 'linear-gradient(180deg, #4a5568 0%, #2d3748 50%, #1a202c 100%)',
      };
      const bgGradient = scene.sceneType ? sceneBgs[scene.sceneType] : scene.background;
      
      // 场景装饰HTML
      let sceneDecor = '';
      if (scene.sceneType === 'train') {
        sceneDecor = `<div class="absolute inset-0 pointer-events-none"><div class="absolute top-8 left-1/4 w-20 h-28 bg-gradient-to-b from-blue-900/50 to-blue-950/70 rounded-lg border-4 border-stone-700"></div><div class="absolute top-8 right-1/4 w-20 h-28 bg-gradient-to-b from-blue-900/50 to-blue-950/70 rounded-lg border-4 border-stone-700"></div><div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-stone-800 to-transparent"></div></div>`;
      } else if (scene.sceneType === 'corridor') {
        sceneDecor = `<div class="absolute inset-0 pointer-events-none"><div class="absolute top-1/4 left-4 w-10 h-28 bg-stone-700/50 rounded border-2 border-stone-600"></div><div class="absolute top-1/4 right-4 w-10 h-28 bg-stone-700/50 rounded border-2 border-stone-600"></div><div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-stone-900 to-transparent"></div></div>`;
      } else if (scene.sceneType === 'room') {
        sceneDecor = `<div class="absolute inset-0 pointer-events-none"><div class="absolute bottom-0 left-0 right-0 h-20 bg-gradient-to-t from-amber-900/60 to-transparent"></div><div class="absolute bottom-20 left-1/2 -translate-x-1/2 w-16 h-32 border-4 border-stone-600 rounded-t-lg bg-stone-800/30"></div></div>`;
      } else if (scene.sceneType === 'dining') {
        sceneDecor = `<div class="absolute inset-0 pointer-events-none"><div class="absolute bottom-20 left-1/2 -translate-x-1/2 w-3/4 h-6 bg-amber-800/60 rounded-lg"></div><div class="absolute top-0 left-1/2 -translate-x-1/2 w-1 h-12 bg-stone-600"></div><div class="absolute top-10 left-1/2 -translate-x-1/2 w-16 h-6 bg-yellow-600/40 rounded-full blur-sm"></div></div>`;
      }
      
      // 火柴人SVG生成函数
      function stickFigure(color, size = 48) {
        return `<svg width="${size}" height="${size * 1.4}" viewBox="0 0 100 140" class="drop-shadow-lg"><circle cx="50" cy="25" r="18" fill="none" stroke="${color}" stroke-width="3"/><text x="50" y="28" text-anchor="middle" font-size="10" fill="${color}">● ●</text><text x="50" y="38" text-anchor="middle" font-size="8" fill="${color}">—</text><line x1="50" y1="43" x2="50" y2="90" stroke="${color}" stroke-width="3"/><line x1="50" y1="55" x2="25" y2="75" stroke="${color}" stroke-width="3"/><line x1="50" y1="55" x2="75" y2="75" stroke="${color}" stroke-width="3"/><line x1="50" y1="90" x2="35" y2="125" stroke="${color}" stroke-width="3"/><line x1="50" y1="90" x2="65" y2="125" stroke="${color}" stroke-width="3"/></svg>`;
      }
      
      container.innerHTML = `
        <div class="game-scene relative w-full h-[420px] rounded-xl overflow-hidden shadow-inner" style="background: ${bgGradient}">
          ${sceneDecor}
          <div class="absolute top-4 left-4 bg-black/60 text-white px-4 py-2 rounded-lg backdrop-blur-sm">
            <h3 class="font-bold text-sm">${scene.name}</h3>
          </div>
          <div class="absolute bottom-4 left-4 right-4 bg-black/70 text-white p-4 rounded-lg backdrop-blur-sm">
            <p class="text-sm leading-relaxed">${scene.description}</p>
          </div>
          ${scene.interactables.map(item => {
            const isCollected = item.evidenceId && state.collectedEvidence.includes(item.evidenceId);
            const isInterviewed = item.witnessId && state.interviewedWitnesses.includes(item.witnessId);
            const itemColor = item.color || (item.type === 'witness' ? '#3b82f6' : item.type === 'evidence' ? '#eab308' : '#78716c');
            if (item.type === 'witness') {
              return `<button class="absolute interactable group" style="left: ${item.position.x}%; top: ${item.position.y}%; transform: translate(-50%, -50%)" onclick="window.__interact('${item.id}')"><div class="relative transition-all duration-300 ${isInterviewed ? 'opacity-60' : 'hover:scale-110'}">${stickFigure(itemColor)}${isInterviewed ? '<div class="absolute -top-1 -right-1 w-5 h-5 bg-green-500 rounded-full flex items-center justify-center text-white text-xs">✓</div>' : ''}</div><div class="absolute -bottom-8 left-1/2 -translate-x-1/2 whitespace-nowrap bg-black/80 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity">${item.name}${isInterviewed ? ' (已询问)' : ''}</div></button>`;
            } else {
              const icon = item.type === 'evidence' ? (isCollected ? '✅' : '🔍') : '🚪';
              const bgColor = item.type === 'evidence' ? 'bg-yellow-500/80' : 'bg-stone-500/80';
              return `<button class="absolute interactable group" style="left: ${item.position.x}%; top: ${item.position.y}%; transform: translate(-50%, -50%)" onclick="window.__interact('${item.id}')"><div class="w-12 h-12 rounded-full flex items-center justify-center text-2xl transition-all duration-300 ${bgColor} ${isCollected ? 'opacity-40 scale-90' : 'hover:scale-110'}">${icon}</div><div class="absolute -bottom-8 left-1/2 -translate-x-1/2 whitespace-nowrap bg-black/80 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity">${item.name}${isCollected ? ' (已收集)' : ''}</div></button>`;
            }
          }).join('')}
          <div class="absolute top-4 right-4 flex flex-col gap-2">
            ${scene.exits.map(exit => `<button class="bg-white/90 hover:bg-white text-stone-800 px-4 py-2 rounded-lg text-sm font-medium shadow-lg transition-all hover:scale-105" onclick="window.__exit('${exit.to}')">${exit.label} →</button>`).join('')}
          </div>
        </div>
      `;
    }

    // 审判阶段渲染
    function renderTrial() {
      document.getElementById('trial-section').classList.remove('hidden');
      
      const panelContainer = document.getElementById('trial-panel-container');
      panelContainer.innerHTML = `
        <div class="bg-stone-800 rounded-xl p-6">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-bold">⚖️ 审判阶段</h2>
            <div class="flex items-center gap-4 text-sm">
              <span>矛盾点: <span class="text-accent-400 font-bold">${state.contradictionsFound.length}/4</span></span>
              <span>信心值: <span class="${state.confidence >= 60 ? 'text-green-400' : state.confidence >= 30 ? 'text-yellow-400' : 'text-red-400'} font-bold">${state.confidence}</span></span>
            </div>
          </div>
          <div class="w-full bg-stone-700 rounded-full h-2 mb-6">
            <div class="h-2 rounded-full ${state.confidence >= 60 ? 'bg-green-500' : state.confidence >= 30 ? 'bg-yellow-500' : 'bg-red-500'}" style="width: ${state.confidence}%"></div>
          </div>
          <h3 class="font-bold mb-3">选择要询问的证人：</h3>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
            ${gameWitnesses.map(w => `
              <button class="p-4 rounded-lg text-left transition-all ${state.currentWitness === w.id ? 'bg-primary-600 ring-2 ring-primary-400' : 'bg-stone-700 hover:bg-stone-600'}" onclick="window.__selectWitness('${w.id}')">
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-2xl">${w.avatar}</span>
                  <span class="font-bold text-sm">${w.name}</span>
                </div>
                <p class="text-xs text-stone-400">${w.description}</p>
              </button>
            `).join('')}
          </div>
          ${state.contradictionsFound.length >= 3 ? `
            <button class="mt-6 w-full py-3 bg-accent-600 rounded-lg font-bold hover:bg-accent-700" onclick="window.__goToEnding()">
              进入最终选择 →
            </button>
          ` : `
            <div class="mt-6 p-4 bg-blue-900/50 rounded-lg text-sm text-blue-200">
              <strong>提示：</strong>选择证人查看证词，点击"追问"获取更多信息，发现矛盾时点击"出示证据"并选择对应证据。正确+20信心值，错误-10。
            </div>
          `}
        </div>
      `;

      // 证人对话（火柴人角色 + 对话历史）
      if (state.currentWitness) {
        const witness = gameWitnesses.find(w => w.id === state.currentWitness);
        if (witness) {
          const dialogContainer = document.getElementById('trial-dialog-container');
          const isFollowedUp = state.interviewedWitnesses.includes(witness.id);
          const testimony = isFollowedUp ? witness.followUpTestimony : witness.initialTestimony;
          const hasContradiction = witness.contradiction && !state.contradictionsFound.find(c => {
            const cont = gameContradictions.find(gc => gc.id === c);
            return cont && cont.witnessId === witness.id;
          });
          
          // 证人颜色映射
          const witnessColors = {
            conductor: '#3b82f6',
            'mrs-hubbard': '#ec4899',
            mary: '#8b5cf6',
            colonel: '#22c55e',
            princess: '#eab308',
            countess: '#06b6d4',
          };
          const witnessColor = witnessColors[witness.id] || '#94a3b8';
          
          // 根据状态决定表情
          let expression = 'normal';
          if (state.witnessReaction === 'contradiction') expression = 'angry';
          else if (state.witnessReaction === 'followup') expression = 'thinking';
          else if (state.witnessReaction === 'shocked') expression = 'surprised';
          
          // 火柴人SVG（支持表情）
          function stickFigureWithExpr(color, expr, size = 56) {
            const eyes = { normal: '● ●', happy: '◠ ◠', sad: '◡ ◡', angry: '> <', surprised: '○ ○', thinking: '● -' };
            const mouth = { normal: '—', happy: '◡', sad: '◠', angry: '︵', surprised: '○', thinking: '~' };
            return `<svg width="${size}" height="${size * 1.4}" viewBox="0 0 100 140" class="drop-shadow-lg"><circle cx="50" cy="25" r="18" fill="none" stroke="${color}" stroke-width="3"/><text x="50" y="28" text-anchor="middle" font-size="10" fill="${color}">${eyes[expr] || eyes.normal}</text><text x="50" y="38" text-anchor="middle" font-size="8" fill="${color}">${mouth[expr] || mouth.normal}</text><line x1="50" y1="43" x2="50" y2="90" stroke="${color}" stroke-width="3"/><line x1="50" y1="55" x2="25" y2="75" stroke="${color}" stroke-width="3"/><line x1="50" y1="55" x2="75" y2="75" stroke="${color}" stroke-width="3"/><line x1="50" y1="90" x2="35" y2="125" stroke="${color}" stroke-width="3"/><line x1="50" y1="90" x2="65" y2="125" stroke="${color}" stroke-width="3"/></svg>`;
          }
          
          // 对话历史HTML
          const historyHtml = state.dialogueHistory && state.dialogueHistory.length > 0 
            ? state.dialogueHistory.slice(-8).map(h => `
                <div class="flex gap-2 text-sm py-1 border-b border-stone-700/50">
                  <span class="font-medium flex-shrink-0" style="color: ${h.color}">${h.speaker}：</span>
                  <span class="text-stone-400">${h.text.substring(0, 60)}${h.text.length > 60 ? '...' : ''}</span>
                </div>
              `).join('')
            : '<p class="text-stone-500 text-sm text-center py-2">暂无对话历史</p>';
          
          dialogContainer.innerHTML = `
            <div class="bg-stone-800 rounded-xl overflow-hidden">
              <!-- 对话历史栏 -->
              <div class="bg-stone-900/50 px-4 py-2 flex items-center justify-between border-b border-stone-700">
                <span class="text-xs text-stone-400">对话记录 (${state.dialogueHistory?.length || 0})</span>
                <button class="text-xs text-primary-400 hover:text-primary-300" onclick="window.__toggleTrialHistory()">${state.showHistory ? '收起' : '查看历史'}</button>
              </div>
              <!-- 历史面板 -->
              <div id="trial-history-panel" class="${state.showHistory ? '' : 'hidden'} max-h-32 overflow-y-auto bg-stone-900/30 px-4 py-2">
                ${historyHtml}
              </div>
              <!-- 对话内容 -->
              <div class="p-6">
                <div class="flex items-start gap-4 mb-4">
                  <div class="flex-shrink-0">
                    ${stickFigureWithExpr(witnessColor, expression)}
                  </div>
                  <div class="pt-2">
                    <h3 class="font-bold text-lg" style="color: ${witnessColor}">${witness.name}</h3>
                    <p class="text-xs text-stone-500">${expression === 'angry' ? '情绪：激动' : expression === 'thinking' ? '情绪：思考' : expression === 'surprised' ? '情绪：惊讶' : '情绪：平静'}</p>
                  </div>
                </div>
                <p class="text-stone-300 leading-relaxed mb-6 min-h-20">${testimony}</p>
                <div class="flex gap-3 justify-end">
                  ${!isFollowedUp ? `<button class="px-4 py-2 bg-stone-600 rounded-lg hover:bg-stone-500 transition-colors" onclick="window.__followUp()">追问</button>` : ''}
                  ${hasContradiction ? `<button class="px-4 py-2 bg-yellow-600 rounded-lg hover:bg-yellow-500 font-bold transition-all hover:scale-105" onclick="window.__presentEvidence()">出示证据</button>` : ''}
                  <button class="px-4 py-2 bg-stone-700 rounded-lg hover:bg-stone-600 transition-colors" onclick="window.__closeWitnessDialog()">关闭</button>
                </div>
              </div>
            </div>
          `;
        }
      } else {
        document.getElementById('trial-dialog-container').innerHTML = '';
      }
    }

    // 结局渲染
    function renderEnding() {
      document.getElementById('ending-section').classList.remove('hidden');
      const choice = state.choices['final-choice'];
      let ending;
      if (choice === 'reveal') {
        ending = { name: '真相大白', description: '你揭露了真相：12名乘客都是凶手，他们为了给阿姆斯特朗一家复仇，每人刺了一刀。你选择将真相告诉警方。正义得到了伸张，但法外之情也令人唏嘘。' };
      } else {
        ending = { name: '法外容情', description: '你揭露了真相，但理解了12人的动机。你选择向警方隐瞒真相，说凶手已经逃走。正义，有时在法律之外。波洛的内心，或许永远不会平静。' };
      }
      
      document.getElementById('ending-title').textContent = ending.name;
      document.getElementById('ending-description').textContent = ending.description;
      document.getElementById('stat-evidence').textContent = state.collectedEvidence.length;
      document.getElementById('stat-witness').textContent = state.interviewedWitnesses.length;
      document.getElementById('stat-contradiction').textContent = state.contradictionsFound.length;
      document.getElementById('stat-confidence').textContent = state.confidence;
    }

    // 证据栏渲染
    function renderEvidenceBar() {
      const container = document.getElementById('evidence-bar-container');
      if (!state.showEvidenceBar) {
        container.innerHTML = '';
        return;
      }
      
      const evidence = state.collectedEvidence.map(id => gameEvidence.find(e => e.id === id)).filter(Boolean);
      container.innerHTML = `
        <div class="fixed bottom-0 left-0 right-0 bg-stone-900 p-4 z-50 border-t border-stone-700">
          <div class="container-page">
            <div class="flex items-center justify-between mb-3">
              <h3 class="font-bold">${state.evidenceMode === 'select' ? '选择要出示的证据' : `证据栏 (${evidence.length})`}</h3>
              ${state.evidenceMode === 'select' ? `<button class="text-sm text-stone-400 hover:text-white" onclick="window.__cancelEvidence()">取消</button>` : ''}
            </div>
            ${evidence.length === 0 ? '<p class="text-stone-400 text-sm">还没有收集到任何证据</p>' : `
              <div class="flex gap-3 overflow-x-auto pb-2">
                ${evidence.map(e => `
                  <button class="flex-shrink-0 w-40 p-3 rounded-lg text-left transition-all ${state.selectedEvidence === e.id ? 'bg-primary-600 ring-2 ring-primary-400' : 'bg-stone-800 hover:bg-stone-700'}" onclick="window.__selectEvidence('${e.id}')">
                    <div class="font-bold text-sm mb-1">${e.name}</div>
                    <div class="text-xs text-stone-300">${e.description}</div>
                    ${state.selectedEvidence === e.id && state.evidenceMode === 'select' ? '<div class="mt-2 text-xs text-primary-200">点击确认出示</div>' : ''}
                  </button>
                `).join('')}
              </div>
            `}
            ${state.evidenceMode === 'select' && state.selectedEvidence ? `
              <button class="mt-3 w-full py-2 bg-yellow-600 rounded-lg font-bold hover:bg-yellow-500" onclick="window.__confirmPresentEvidence()">
                确认出示「${gameEvidence.find(e => e.id === state.selectedEvidence)?.name}」
              </button>
            ` : ''}
          </div>
        </div>
      `;
    }


    // 记录对话历史
    function addDialogueHistory(speaker, text, color) {
      if (!state.dialogueHistory) state.dialogueHistory = [];
      state.dialogueHistory.push({ speaker, text, color, time: Date.now() });
      // 最多保留50条
      if (state.dialogueHistory.length > 50) {
        state.dialogueHistory = state.dialogueHistory.slice(-50);
      }
    }
    
    // 切换对话历史显示
    window.__toggleTrialHistory = function() {
      state.showHistory = !state.showHistory;
      const panel = document.getElementById('trial-history-panel');
      if (panel) panel.classList.toggle('hidden');
      renderTrial();
    };
    
    // 设置证人表情
    function setWitnessReaction(reaction) {
      state.witnessReaction = reaction;
      setTimeout(() => {
        state.witnessReaction = 'normal';
        if (state.currentWitness) renderTrial();
      }, 2000);
    }

    // 游戏交互函数
    window.__introContinue = function() {
      state.dialogIndex++;
      if (state.dialogIndex >= 12) {
        state.gamePhase = 'investigation';
        state.currentScene = 'corridor';
        state.dialogIndex = 0;
      }
      render();
    };

    window.__interact = function(itemId) {
      const scene = gameScenes.find(s => s.id === state.currentScene);
      const item = scene?.interactables.find(i => i.id === itemId);
      if (!item) return;

      if (item.type === 'evidence' && item.evidenceId) {
        if (!state.collectedEvidence.includes(item.evidenceId)) {
          const evidence = gameEvidence.find(e => e.id === item.evidenceId);
          // 使用证据卡片替代alert
          GameUI.showEvidenceCard(evidence, (ev) => {
            state.collectedEvidence.push(ev.id);
            GameUI.showToast(`收集到证据：${ev.name}`, 'success');
            // 自动添加到笔记线索
            PlayerData.addNotebookItem('clues', `【证据】${ev.name}：${ev.description}`);
            // 播放收集动画
            const rect = event.target.getBoundingClientRect();
            GameUI.playCollectAnimation(rect.left, rect.top, ev.name);
            render();
          });
        } else {
          const evidence = gameEvidence.find(e => e.id === item.evidenceId);
          GameUI.showEvidenceCard(evidence, null);
        }
      } else if (item.type === 'witness' && item.witnessId) {
        if (!state.interviewedWitnesses.includes(item.witnessId)) {
          state.interviewedWitnesses.push(item.witnessId);
          GameUI.showToast(`询问了${gameWitnesses.find(w => w.id === item.witnessId)?.name}`, 'info');
        }
        const witness = gameWitnesses.find(w => w.id === item.witnessId);
        const witnessColors = {
          conductor: '#3b82f6',
          'mrs-hubbard': '#ec4899',
          mary: '#8b5cf6',
          colonel: '#22c55e',
          princess: '#eab308',
          countess: '#06b6d4',
        };
        const color = witnessColors[witness.id] || '#94a3b8';
        // 使用对话框替代alert
        GameUI.showDialog({
          speaker: witness.name,
          color: color,
          text: witness.initialTestimony,
          options: witness.followUpTestimony ? [{
            text: '追问更多细节',
            action: () => {
              GameUI.showDialog({
                speaker: witness.name,
                color: color,
                text: witness.followUpTestimony,
              });
            }
          }] : [],
        });
      } else if (item.type === 'object') {
        GameUI.showDialog({
          speaker: '',
          color: '#94a3b8',
          text: item.description,
        });
      }
      render();
    };

    window.__exit = function(sceneId) {
      if (sceneId === 'dining-car' && state.gamePhase === 'investigation') {
        if (state.collectedEvidence.length >= 3 && state.interviewedWitnesses.length >= 3) {
          GameUI.showModal({
            title: '进入审判阶段？',
            message: '调查阶段将结束，未收集的证据将无法获取。确定要前往餐车进行审判吗？',
            confirmText: '进入审判',
            cancelText: '继续调查',
            type: 'warning',
            onConfirm: () => {
              state.gamePhase = 'trial';
              state.currentScene = 'dining-car';
              render();
            }
          });
        } else {
          GameUI.showModal({
            title: '还不能进入审判',
            message: `还需要收集至少3件证据和询问3个证人。\n当前：证据${state.collectedEvidence.length}/3，证人${state.interviewedWitnesses.length}/3`,
            confirmText: '我知道了',
            cancelText: '关闭',
            type: 'info',
            onConfirm: () => {},
            onCancel: () => {}
          });
          return;
        }
      }
      state.currentScene = sceneId;
      render();
    };

    window.__selectWitness = function(witnessId) {
      state.currentWitness = witnessId;
      if (!state.interviewedWitnesses.includes(witnessId)) {
        state.interviewedWitnesses.push(witnessId);
      }
      render();
    };

    window.__followUp = function() {
      const witness = gameWitnesses.find(w => w.id === state.currentWitness);
      if (witness) {
        const witnessColors = {
          conductor: '#3b82f6',
          'mrs-hubbard': '#ec4899',
          mary: '#8b5cf6',
          colonel: '#22c55e',
          princess: '#eab308',
          countess: '#06b6d4',
        };
        const color = witnessColors[witness.id] || '#94a3b8';
        GameUI.showDialog({
          speaker: witness.name,
          color: color,
          text: witness.followUpTestimony,
        });
      }
      render();
    };

    window.__presentEvidence = function() {
      state.evidenceMode = 'select';
      state.showEvidenceBar = true;
      render();
    };

    window.__selectEvidence = function(evidenceId) {
      if (state.evidenceMode === 'select') {
        state.selectedEvidence = evidenceId;
        render();
      } else {
        const evidence = gameEvidence.find(e => e.id === evidenceId);
        GameUI.showEvidenceCard(evidence, null);
      }
    };

    window.__cancelEvidence = function() {
      state.evidenceMode = 'view';
      state.selectedEvidence = null;
      state.showEvidenceBar = false;
      render();
    };

    window.__confirmPresentEvidence = function() {
      const witness = gameWitnesses.find(w => w.id === state.currentWitness);
      const evidence = gameEvidence.find(e => e.id === state.selectedEvidence);
      
      if (witness?.contradiction && witness.contradiction.evidenceId === state.selectedEvidence) {
        // 正确指出矛盾
        const cont = gameContradictions.find(c => c.witnessId === witness.id && c.evidenceId === state.selectedEvidence);
        if (cont && !state.contradictionsFound.includes(cont.id)) {
          state.contradictionsFound.push(cont.id);
          state.confidence = Math.min(100, state.confidence + 20);
          GameUI.showDialog({
            speaker: '波洛',
            color: '#fbbf24',
            text: `正确！发现矛盾！\n\n${witness.contradiction.revealedText}\n\n信心值 +20`,
          });
        }
      } else {
        // 错误
        state.confidence = Math.max(0, state.confidence - 10);
        GameUI.showToast('这个证据与证词没有直接矛盾... 信心值 -10', 'warning', 3000);
      }
      
      state.evidenceMode = 'view';
      state.selectedEvidence = null;
      state.showEvidenceBar = false;
      render();
    };

    window.__closeWitnessDialog = function() {
      state.currentWitness = null;
      render();
    };

    window.__goToEnding = function() {
      state.gamePhase = 'ending';
      render();
    };

    window.__makeFinalChoice = function(choice) {
      GameUI.showModal({
        title: '做出最终选择？',
        message: '这将决定游戏结局，无法更改。确定要做出这个选择吗？',
        confirmText: '确定',
        cancelText: '再想想',
        type: 'danger',
        onConfirm: () => {
          state.choices['final-choice'] = choice;
          render();
        }
      });
    };

    // 证据栏按钮
    document.getElementById('evidence-btn')?.addEventListener('click', () => {
      state.showEvidenceBar = !state.showEvidenceBar;
      state.evidenceMode = 'view';
      render();
    });

    // 重置按钮
    document.getElementById('reset-btn')?.addEventListener('click', () => {
      GameUI.showModal({
        title: '重置游戏？',
        message: '所有进度将丢失，确定要重置吗？',
        confirmText: '重置',
        cancelText: '取消',
        type: 'danger',
        onConfirm: () => {
        localStorage.removeItem('fun-detective-prototype-save');
        state = {
          currentScene: 'intro',
          gamePhase: 'intro',
          collectedEvidence: [],
          interviewedWitnesses: [],
          contradictionsFound: [],
          confidence: 100,
          choices: {},
          dialogIndex: 0,
          currentWitness: null,
          showEvidenceBar: false,
          selectedEvidence: null,
          evidenceMode: 'view',
        };
        render();
        }
      });
    });

    // 开场继续按钮
    document.getElementById('intro-continue')?.addEventListener('click', () => {
      window.__introContinue();
    });

    // 结局重新开始
    document.getElementById('ending-restart')?.addEventListener('click', () => {
      localStorage.removeItem('fun-detective-prototype-save');
      window.location.reload();
    });

    // 启动
    init();
  </script>
</BaseLayout>
