---
import GameLayout from '@layouts/GameLayout.astro';
---

<GameLayout title="东方快车：推理审判" description="可交互推理游戏原型">
  <!-- 加载态容器 -->
  <div id="game-loading" class="fixed inset-0 z-50 flex items-center justify-center" style="background: var(--game-bg, #0d0d12);">
    <div class="text-center">
      <div class="w-12 h-12 border-4 border-t-transparent rounded-full animate-spin mx-auto mb-4" style="border-color: var(--game-accent, #f59e0b); border-top-color: transparent;"></div>
      <p id="loading-case-name" class="text-lg font-bold" style="color: var(--game-text, #e8e8f0);">正在准备案件…</p>
      <p class="text-sm mt-2" style="color: var(--game-text-muted, #8888a0);">加载推理素材、证物与证人档案</p>
    </div>
  </div>

    <!-- 错误态容器 -->
  <div id="game-error" class="fixed inset-0 z-50 hidden items-center justify-center" style="background: var(--game-bg, #0d0d12);">
    <div class="text-center max-w-md p-8">
      <div class="mb-4 flex justify-center" style="color: var(--game-danger, #ef4444);">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      </div>
      <h2 class="text-xl font-bold mb-2" style="color: var(--game-text, #e8e8f0);">案件加载失败</h2>
      <p id="error-message" class="text-sm mb-6" style="color: var(--game-text-muted, #8888a0);"></p>
      <div class="flex gap-3 justify-center">
        <button id="error-retry" class="px-6 py-3 rounded-lg font-bold game-button" style="background: var(--game-accent, #f59e0b); color: #0d0d12; min-height: 44px;">重试</button>
        <button id="error-back" class="px-6 py-3 rounded-lg font-bold game-button border" style="border-color: var(--game-border, #2e2e3e); color: var(--game-text, #e8e8f0); min-height: 44px;">返回案件列表</button>
      </div>
    </div>
  </div>

  <div class="min-h-screen text-white" style="background: var(--game-bg, #0d0d12);">
    <!-- 游戏顶部栏：左[退出] 中[案件名·阶段·目标] 右[证据·关联·时间线·更多] -->
    <div id="game-topbar" class="flex items-center justify-between px-3 py-2 sticky top-0 z-40" style="background: var(--game-surface, #1a1a24); border-bottom: 1px solid var(--game-border, #2e2e3e);">
      <!-- 左侧：退出 -->
      <button id="exit-btn" onclick="GameInteractions.confirmExit()" class="game-button flex items-center gap-1 px-3 py-2 rounded-lg text-sm" style="color: var(--game-text-muted, #8888a0); min-height: 44px;" aria-label="退出游戏，返回案件列表">
        ← 退出
      </button>

      <!-- 中央：案件名 + 阶段 + 当前目标 -->
      <div id="topbar-center" class="flex-1 text-center mx-2 min-w-0">
        <div id="case-title" class="font-bold text-sm truncate" style="color: var(--game-text, #e8e8f0);">推理游戏</div>
        <div class="text-xs truncate flex items-center justify-center gap-2" style="color: var(--game-text-muted, #8888a0);">
          <span id="phase-indicator">开场</span>
          <span id="confidence-display" class="hidden sm:inline">信心: 100</span>
          <span id="objective-display" aria-live="polite"></span>
        </div>
      </div>

      <!-- 右侧：操作按钮 -->
      <div class="flex items-center gap-2">
        <button id="evidence-btn" data-tour="evidence" onclick="GameInteractions.toggleEvidenceBar()" class="game-button px-3 py-2 rounded-lg text-sm relative" style="background: var(--game-surface-hover, #252532); color: var(--game-text, #e8e8f0); min-height: 44px;" aria-label="证据栏">
          证据 <span id="evidence-count" class="font-bold" style="color: var(--game-accent, #f59e0b);">0</span>
        </button>
        <button id="relation-btn" data-tour="relation" onclick="EvidenceBoard.openBoard()" class="game-button px-3 py-2 rounded-lg text-sm hidden" style="background: var(--game-accent-soft, rgba(245,158,11,0.15)); color: var(--game-accent, #f59e0b); min-height: 44px;" aria-label="线索关联板">
          关联
        </button>
        <button id="timeline-btn" data-tour="timeline" onclick="TimelineUI.open()" class="game-button px-3 py-2 rounded-lg text-sm hidden" style="background: rgba(59,130,246,0.15); color: var(--game-info, #3b82f6); min-height: 44px;" aria-label="案件时间线">
          时间线
        </button>
        <button id="more-btn" data-tour="more" onclick="GameUI.toggleMoreMenu()" class="game-button px-3 py-2 rounded-lg text-lg font-bold" style="background: var(--game-surface-hover, #252532); color: var(--game-text, #e8e8f0); min-height: 44px; width: 44px;" aria-label="更多选项" title="更多">
          ⋯
        </button>
      </div>
    </div>

    <!-- 更多菜单抽屉 -->
    <div id="more-menu" class="hidden fixed top-16 right-3 z-50 rounded-xl shadow-2xl p-2 min-w-[200px]" style="background: var(--game-surface, #1a1a24); border: 1px solid var(--game-border, #2e2e3e);" role="menu">
      <button data-tour="notebook" onclick="NotebookUI.open(); GameUI.closeMoreMenu();" class="game-button w-full text-left px-4 py-3 rounded-lg flex items-center gap-3 text-sm" style="color: var(--game-text, #e8e8f0); min-height: 44px;" role="menuitem" aria-label="推理笔记">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg> 笔记
      </button>
      <button id="more-relation" onclick="EvidenceBoard.openBoard(); GameUI.closeMoreMenu();" class="game-button w-full text-left px-4 py-3 rounded-lg flex items-center gap-3 text-sm hidden" style="color: var(--game-text, #e8e8f0); min-height: 44px;" role="menuitem" aria-label="线索关联板">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg> 线索关联
      </button>
      <button id="more-timeline" onclick="TimelineUI.open(); GameUI.closeMoreMenu();" class="game-button w-full text-left px-4 py-3 rounded-lg flex items-center gap-3 text-sm hidden" style="color: var(--game-text, #e8e8f0); min-height: 44px;" role="menuitem" aria-label="案件时间线">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> 案件时间线
      </button>
      <div style="border-top: 1px solid var(--game-border, #2e2e3e); margin: 4px 0;"></div>
      <button onclick="GuideUI.openTutorial(); GameUI.closeMoreMenu();" class="game-button w-full text-left px-4 py-3 rounded-lg flex items-center gap-3 text-sm" style="color: var(--game-text, #e8e8f0); min-height: 44px;" role="menuitem" aria-label="帮助与教程重看">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg> 帮助 / 教程重看
      </button>
      <button onclick="GameInteractions.resetGame(); GameUI.closeMoreMenu();" class="game-button w-full text-left px-4 py-3 rounded-lg flex items-center gap-3 text-sm" style="color: var(--game-danger, #ef4444); min-height: 44px;" role="menuitem" aria-label="重置游戏进度">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg> 重置进度
      </button>
    </div>

    <!-- 游戏主区域 -->
    <div class="container-page py-6 pb-32">
      <!-- 开场/对话阶段 -->
      <div id="intro-section" class="max-w-2xl mx-auto hidden">
        <div class="bg-stone-800 rounded-xl p-8 min-h-64 flex flex-col justify-between">
          <div class="flex items-center justify-between mb-4">
            <span id="intro-progress" class="text-xs text-stone-500 font-mono">开场 1/12</span>
            <button onclick="GameRender.skipIntro()" class="text-xs text-stone-400 hover:text-white px-3 py-1.5 rounded hover:bg-stone-700 transition-colors" style="min-height:32px;">跳过开场</button>
          </div>
          <div id="intro-text" class="text-lg leading-relaxed text-stone-200"></div>
          <button id="intro-continue" class="mt-6 self-end px-6 py-2 bg-primary-600 rounded-lg hover:bg-primary-700" style="min-height:44px;">
            继续
          </button>
        </div>
      </div>

      <!-- 调查阶段 -->
      <div id="investigation-section" class="hidden">
        <div class="mb-4">
          <h2 class="text-xl font-bold mb-2 flex items-center gap-2">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--game-accent);"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            调查阶段
          </h2>
          <p id="investigation-hint" class="text-sm text-stone-400">点击场景中的物品和人物进行互动。</p>
        </div>
        <div id="game-scene-container" data-tour="stage"></div>
      </div>

      <!-- 审判阶段 -->
      <div id="trial-section" class="hidden max-w-4xl mx-auto">
        <div id="trial-panel-container"></div>
        <div id="trial-dialog-container" class="mt-6"></div>
      </div>

      <!-- 结局阶段 -->
      <div id="ending-section" class="hidden max-w-2xl mx-auto">
        <div class="bg-stone-800 rounded-xl p-8">
          <div id="ending-grade"></div>
          <h2 id="ending-title" class="text-3xl font-bold mb-4 text-center"></h2>
          <p id="ending-description" class="text-lg leading-relaxed text-stone-300 mb-6"></p>
          <div id="ending-stats" class="bg-stone-700 rounded-lg p-4 mb-6">
            <h3 class="font-bold mb-2">游戏统计</h3>
            <div class="grid grid-cols-2 gap-2 text-sm">
              <div>收集证据: <span id="stat-evidence"></span></div>
              <div>询问证人: <span id="stat-witness"></span></div>
              <div>揭露矛盾: <span id="stat-contradiction"></span></div>
              <div>最终信心值: <span id="stat-confidence"></span></div>
            </div>
          </div>
          <div class="flex gap-4 justify-center">
            <button id="ending-restart" class="px-6 py-2 bg-primary-600 rounded-lg hover:bg-primary-700">重新开始</button>
            <a href="/fun_detective/game-design" class="px-6 py-2 bg-stone-600 rounded-lg hover:bg-stone-500">返回游戏设计</a>
          </div>
        </div>
      </div>
    </div>

    <!-- 证据栏 -->
    <div id="evidence-bar-container"></div>

    <!-- 异议动画遮罩 -->
    <div id="objection-overlay" class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-black/80 pointer-events-none">
      <div class="objection-text text-8xl font-black text-red-500 animate-bounce" style="text-shadow: 0 0 20px rgba(239,68,68,0.8); transform: rotate(-5deg);">
        异议！
      </div>
    </div>

    <!-- 时间线弹窗 -->
    <div id="timeline-overlay" class="hidden fixed inset-0 z-[90] flex items-center justify-center bg-black/70" role="dialog" aria-modal="true" aria-label="案件时间线">
      <div class="bg-stone-800 rounded-xl p-6 w-full max-w-2xl max-h-[80vh] overflow-hidden border border-stone-600">
        <div class="flex items-center justify-between mb-4">
          <div></div>
          <button onclick="TimelineUI.close()" class="text-stone-400 hover:text-white text-xl">✕</button>
        </div>
        <div id="timeline-content"></div>
      </div>
    </div>

    <!-- 新手教程弹窗 -->
    <div id="tutorial-overlay" class="hidden fixed inset-0 z-[95] flex items-center justify-center bg-black/80" role="dialog" aria-modal="true" aria-label="新手教程">
      <div class="bg-stone-800 rounded-xl p-8 w-full max-w-lg border border-amber-600/50">
        <div id="tutorial-content"></div>
      </div>
    </div>

    <!-- 结局弹窗 -->
    <div id="ending-overlay" class="hidden fixed inset-0 z-[95] flex items-center justify-center bg-black/90 overflow-y-auto">
      <div class="bg-stone-800 rounded-xl p-6 w-full max-w-xl my-8 border border-stone-600">
        <div id="ending-content"></div>
      </div>
    </div>

    <!-- 对话框 -->
    <div id="dialog-container"></div>
  </div>

  <!-- 游戏专用 CSS Token 与焦点样式 -->
  <style is:global>
    :root {
      --game-bg: #0d0d12;
      --game-surface: #1a1a24;
      --game-surface-hover: #252532;
      --game-border: #2e2e3e;
      --game-text: #e8e8f0;
      --game-text-muted: #8888a0;
      --game-accent: #f59e0b;
      --game-accent-soft: rgba(245,158,11,0.15);
      --game-danger: #ef4444;
      --game-success: #22c55e;
      --game-info: #3b82f6;
      --game-radius: 12px;
      --game-focus-ring: 0 0 0 3px rgba(245,158,11,0.5);
    }
    [data-case="orient-express"] { --game-accent: #f59e0b; --game-focus-ring: 0 0 0 3px rgba(245,158,11,0.5); }
    [data-case="study-in-scarlet"] { --game-accent: #dc2626; --game-focus-ring: 0 0 0 3px rgba(220,38,38,0.5); }
    [data-case="phoenix-wright-1"] { --game-accent: #3b82f6; --game-focus-ring: 0 0 0 3px rgba(59,130,246,0.5); }

    .game-button:focus-visible {
      outline: none;
      box-shadow: var(--game-focus-ring);
      border-radius: var(--game-radius);
    }
    .game-button {
      cursor: pointer;
      transition: all 0.15s ease;
    }

    /* 场景热点脉冲动画（首次进入场景） */
    @keyframes hotspot-pulse {
      0%, 100% { box-shadow: 0 0 0 0 rgba(245,158,11,0.6); }
      50% { box-shadow: 0 0 0 12px rgba(245,158,11,0); }
    }
    .hotspot-pulse {
      animation: hotspot-pulse 1.5s ease-in-out 2;
    }

    /* 可调查物高亮 */
    .hotspot-highlight {
      box-shadow: 0 0 16px 4px var(--game-accent) !important;
    }

    /* 热点隐藏模式：降低不透明度 */
    .hotspots-dimmed .interactable {
      opacity: 0.25;
      transition: opacity 0.2s ease;
    }
    .hotspots-dimmed .interactable:hover {
      opacity: 1;
    }

    /* 教程高亮脉冲 */
    @keyframes tutorial-pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }

    /* ========== 移动端适配 ========== */
    @media (max-width: 640px) {
      #game-topbar { padding: 0.4rem 0.5rem; gap: 0.35rem; }
      #exit-btn { padding: 0 0.5rem; font-size: 0.75rem; min-height: 44px; }
      #case-title { font-size: 0.75rem; max-width: 100px; }
      #topbar-center .text-xs { font-size: 0.65rem; }
      #confidence-display { display: none !important; }
      #evidence-btn { padding: 0 0.5rem; font-size: 0.75rem; min-height: 44px; }
      #relation-btn, #timeline-btn { padding: 0 0.4rem; font-size: 0.75rem; min-height: 44px; }
      #more-btn { width: 44px; height: 44px; min-height: 44px; padding: 0; font-size: 1.1rem; }
      .game-scene { height: 320px !important; }
      .game-scene .absolute.bottom-4 { bottom: 0.5rem; left: 0.5rem; right: 0.5rem; padding: 0.75rem; }
      .game-scene .absolute.bottom-4 p { font-size: 0.75rem; line-height: 1.4; }
      /* 移动端：场景出口移到底部，避免遮挡人物标签 */
      .game-scene .scene-exits { top: auto !important; bottom: 5rem !important; right: 0.5rem !important; flex-direction: row !important; flex-wrap: wrap; gap: 0.25rem !important; }
      .game-scene .scene-exits button { padding: 0.25rem 0.5rem; font-size: 0.7rem; min-height: 36px; }
      #more-menu { left: 0.5rem; right: 0.5rem; min-width: auto; }
      #game-dialog-box { max-width: 100%; border-radius: 1rem 1rem 0 0; }
      /* 弹层按钮触控尺寸 */
      #game-evidence-card button, #evidence-board-overlay button { min-height: 44px; }
    }
    @media (max-width: 380px) {
      #case-title { max-width: 70px; }
      #exit-btn { padding: 0 0.35rem; font-size: 0.7rem; }
      #evidence-btn { padding: 0 0.35rem; font-size: 0.7rem; }
      #relation-btn, #timeline-btn { padding: 0 0.3rem; font-size: 0.7rem; }
      .game-scene { height: 280px !important; }
    }
    /* 可访问性：正文最小字号（仅作用于明确的正文文本容器，不覆盖标题/数值/状态层级） */
    #game-dialog-text,
    #intro-text,
    #ending-description,
    #investigation-hint,
    .game-scene .scene-description p {
      font-size: max(0.875rem, 14px);
    }
    /* 状态指示：图标+文字，不依赖颜色 alone */
    .status-indicator { display: inline-flex; align-items: center; gap: 0.25rem; }
    /* 焦点可见性 */
    button:focus-visible, a:focus-visible {
      outline: 2px solid #f59e0b;
      outline-offset: 2px;
    }
  </style>

  <!-- 引入案件配置（必须在动态加载之前） -->
  <script is:inline src="/fun_detective/game/cases/index.js"></script>
  <!-- 引入音效系统 -->
  <script is:inline src="/fun_detective/game/audio-config.js"></script>
  <script is:inline src="/fun_detective/game/audioManager.js"></script>
  <!-- 引入游戏UI工具模块 -->
  <script is:inline src="/fun_detective/game/ui.js"></script>
  <!-- 引入玩家数据与笔记系统 -->
  <script is:inline src="/fun_detective/game/playerData.js"></script>
  <script is:inline src="/fun_detective/game/notebookUI.js"></script>
  <!-- 引入证据关联系统 -->
  <script is:inline src="/fun_detective/game/evidence-board.js"></script>
  <!-- 引入时间线系统 -->
  <script is:inline src="/fun_detective/game/timelineUI.js"></script>
  <!-- 引入游戏引导系统 -->
  <script is:inline src="/fun_detective/game/guideUI.js"></script>
  <!-- 引入结局系统 -->
  <script is:inline src="/fun_detective/game/endingUI.js"></script>

    <!-- 引入游戏核心模块（按依赖顺序） -->
  <script is:inline src="/fun_detective/game/gameState.js"></script>
  <script is:inline src="/fun_detective/game/gameRender.js"></script>
  <script is:inline src="/fun_detective/game/gameInteractions.js"></script>

  <script is:inline>
    // 游戏初始化：加载案件数据后初始化
    GameState.loadCaseData(GameState.currentCaseId, () => {
      GameState.init();
      // 初始化游戏引导系统
      if (window.GuideUI) {
        GuideUI.init();
        GuideUI.renderObjective();
      }
    });
  </script>
</GameLayout>
