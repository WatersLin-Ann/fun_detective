      document.getElementById('inv-witness-count').textContent = state.interviewedWitnesses.length;
      
      // 鍦烘櫙鍒囨崲鍔ㄧ敾
      const sceneContainer = document.getElementById('game-scene-container');
      if (sceneContainer && !state.isTransitioning) {
        state.isTransitioning = true;
        sceneContainer.style.opacity = '0';
        sceneContainer.style.transform = 'translateY(10px)';
        sceneContainer.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
        setTimeout(() => {
          sceneContainer.style.opacity = '1';
          sceneContainer.style.transform = 'translateY(0)';
          state.isTransitioning = false;
        }, 50);
      }

      const scene = gameScenes.find(s => s.id === state.currentScene);
      if (!scene) return;

      const container = document.getElementById('game-scene-container');
      
      // 鍦烘櫙鑳屾櫙閰嶇疆
      const sceneBgs = {
        train: 'linear-gradient(180deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%)',
        room: 'linear-gradient(180deg, #2d2d2d 0%, #3d3d3d 50%, #4a4a4a 100%)',
        corridor: 'linear-gradient(180deg, #1a1a1a 0%, #2a2a2a 50%, #333 100%)',
        dining: 'linear-gradient(180deg, #3d2914 0%, #5c3d1e 50%, #7a5230 100%)',
        outdoor: 'linear-gradient(180deg, #87ceeb 0%, #98d8c8 50%, #f7dc6f 100%)',
        office: 'linear-gradient(180deg, #4a5568 0%, #2d3748 50%, #1a202c 100%)',
      };
      const bgGradient = scene.sceneType ? sceneBgs[scene.sceneType] : scene.background;
      
      // 鍦烘櫙瑁呴グHTML
      let sceneDecor = '';
      if (scene.sceneType === 'train') {
        sceneDecor = `<div class="absolute inset-0 pointer-events-none"><div class="absolute top-8 left-1/4 w-20 h-28 bg-gradient-to-b from-blue-900/50 to-blue-950/70 rounded-lg border-4 border-stone-700"></div><div class="absolute top-8 right-1/4 w-20 h-28 bg-gradient-to-b from-blue-900/50 to-blue-950/70 rounded-lg border-4 border-stone-700"></div><div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-stone-800 to-transparent"></div></div>`;
      } else if (scene.sceneType === 'corridor') {
        sceneDecor = `<div class="absolute inset-0 pointer-events-none"><div class="absolute top-1/4 left-4 w-10 h-28 bg-stone-700/50 rounded border-2 border-stone-600"></div><div class="absolute top-1/4 right-4 w-10 h-28 bg-stone-700/50 rounded border-2 border-stone-600"></div><div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-stone-900 to-transparent"></div></div>`;
      } else if (scene.sceneType === 'room') {
        sceneDecor = `<div class="absolute inset-0 pointer-events-none"><div class="absolute bottom-0 left-0 right-0 h-20 bg-gradient-to-t from-amber-900/60 to-transparent"></div><div class="absolute bottom-20 left-1/2 -translate-x-1/2 w-16 h-32 border-4 border-stone-600 rounded-t-lg bg-stone-800/30"></div></div>`;
      } else if (scene.sceneType === 'dining') {
        sceneDecor = `<div class="absolute inset-0 pointer-events-none"><div class="absolute bottom-20 left-1/2 -translate-x-1/2 w-3/4 h-6 bg-amber-800/60 rounded-lg"></div><div class="absolute top-0 left-1/2 -translate-x-1/2 w-1 h-12 bg-stone-600"></div><div class="absolute top-10 left-1/2 -translate-x-1/2 w-16 h-6 bg-yellow-600/40 rounded-full blur-sm"></div></div>`;
      }
      
      // 鐏煷浜篠VG鐢熸垚鍑芥暟
      function stickFigure(color, size = 48) {
        return `<svg width="${size}" height="${size * 1.4}" viewBox="0 0 100 140" class="drop-shadow-lg"><circle cx="50" cy="25" r="18" fill="none" stroke="${color}" stroke-width="3"/><text x="50" y="28" text-anchor="middle" font-size="10" fill="${color}">鈼?鈼?/text><text x="50" y="38" text-anchor="middle" font-size="8" fill="${color}">鈥?/text><line x1="50" y1="43" x2="50" y2="90" stroke="${color}" stroke-width="3"/><line x1="50" y1="55" x2="25" y2="75" stroke="${color}" stroke-width="3"/><line x1="50" y1="55" x2="75" y2="75" stroke="${color}" stroke-width="3"/><line x1="50" y1="90" x2="35" y2="125" stroke="${color}" stroke-width="3"/><line x1="50" y1="90" x2="65" y2="125" stroke="${color}" stroke-width="3"/></svg>`;
      }
      
      container.innerHTML = `
        <div class="game-scene relative w-full h-[420px] rounded-xl overflow-hidden shadow-inner" style="background: ${bgGradient}">
          ${sceneDecor}
          <div class="absolute top-4 left-4 bg-black/60 text-white px-4 py-2 rounded-lg backdrop-blur-sm">
            <h3 class="font-bold text-sm">${scene.name}</h3>
          </div>
          <div class="absolute bottom-4 left-4 right-4 bg-black/70 text-white p-4 rounded-lg backdrop-blur-sm">
            <p class="text-sm leading-relaxed">${scene.description}</p>
          </div>
          ${scene.interactables.map(item => {
            const isCollected = item.evidenceId && state.collectedEvidence.includes(item.evidenceId);
            const isInterviewed = item.witnessId && state.interviewedWitnesses.includes(item.witnessId);
            const itemColor = item.color || (item.type === 'witness' ? '#3b82f6' : item.type === 'evidence' ? '#eab308' : '#78716c');
            if (item.type === 'witness') {
              return `<button class="absolute interactable group" style="left: ${item.position.x}%; top: ${item.position.y}%; transform: translate(-50%, -50%)" onclick="window.__interact('${item.id}')"><div class="relative transition-all duration-300 ${isInterviewed ? 'opacity-60' : 'hover:scale-110'}">${stickFigure(itemColor)}${isInterviewed ? '<div class="absolute -top-1 -right-1 w-5 h-5 bg-green-500 rounded-full flex items-center justify-center text-white text-xs">鉁?/div>' : ''}</div><div class="absolute -bottom-8 left-1/2 -translate-x-1/2 whitespace-nowrap bg-black/80 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity">${item.name}${isInterviewed ? ' (宸茶闂?' : ''}</div></button>`;
            } else {
              const icon = item.type === 'evidence' ? (isCollected ? '鉁? : '馃攳') : '馃毆';
              const bgColor = item.type === 'evidence' ? 'bg-yellow-500/80' : 'bg-stone-500/80';
              return `<button class="absolute interactable group" style="left: ${item.position.x}%; top: ${item.position.y}%; transform: translate(-50%, -50%)" onclick="window.__interact('${item.id}')"><div class="w-12 h-12 rounded-full flex items-center justify-center text-2xl transition-all duration-300 ${bgColor} ${isCollected ? 'opacity-40 scale-90' : 'hover:scale-110'}">${icon}</div><div class="absolute -bottom-8 left-1/2 -translate-x-1/2 whitespace-nowrap bg-black/80 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity">${item.name}${isCollected ? ' (宸叉敹闆?' : ''}</div></button>`;
            }
          }).join('')}
          <div class="absolute top-4 right-4 flex flex-col gap-2">
            ${scene.exits.map(exit => `<button class="bg-white/90 hover:bg-white text-stone-800 px-4 py-2 rounded-lg text-sm font-medium shadow-lg transition-all hover:scale-105" onclick="window.__exit('${exit.to}')">${exit.label} 鈫?/button>`).join('')}
          </div>
        </div>
      `;
    }

    // 瀹″垽闃舵娓叉煋
    function renderTrial() {
      document.getElementById('trial-section').classList.remove('hidden');
      
      const panelContainer = document.getElementById('trial-panel-container');
      panelContainer.innerHTML = `
        <div class="bg-stone-800 rounded-xl p-6">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-bold">鈿栵笍 瀹″垽闃舵</h2>
            <div class="flex items-center gap-4 text-sm">
              <span>鐭涚浘鐐? <span class="text-accent-400 font-bold">${state.contradictionsFound.length}/4</span></span>
              <span>淇″績鍊? <span class="${state.confidence >= 60 ? 'text-green-400' : state.confidence >= 30 ? 'text-yellow-400' : 'text-red-400'} font-bold">${state.confidence}</span></span>
            </div>
          </div>
          <div class="w-full bg-stone-700 rounded-full h-2 mb-6">
            <div class="h-2 rounded-full ${state.confidence >= 60 ? 'bg-green-500' : state.confidence >= 30 ? 'bg-yellow-500' : 'bg-red-500'}" style="width: ${state.confidence}%"></div>
          </div>
          <h3 class="font-bold mb-3">閫夋嫨瑕佽闂殑璇佷汉锛?/h3>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
            ${gameWitnesses.map(w => `
              <button class="p-4 rounded-lg text-left transition-all ${state.currentWitness === w.id ? 'bg-primary-600 ring-2 ring-primary-400' : 'bg-stone-700 hover:bg-stone-600'}" onclick="window.__selectWitness('${w.id}')">
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-2xl">${w.avatar}</span>
                  <span class="font-bold text-sm">${w.name}</span>
                </div>
                <p class="text-xs text-stone-400">${w.description}</p>
              </button>
            `).join('')}
          </div>
          ${state.contradictionsFound.length >= 3 ? `
            <button class="mt-6 w-full py-3 bg-accent-600 rounded-lg font-bold hover:bg-accent-700" onclick="window.__goToEnding()">
              杩涘叆鏈€缁堥€夋嫨 鈫?
            </button>
          ` : `
            <div class="mt-6 p-4 bg-blue-900/50 rounded-lg text-sm text-blue-200">
              <strong>鎻愮ず锛?/strong>閫夋嫨璇佷汉鏌ョ湅璇佽瘝锛岀偣鍑?杩介棶"鑾峰彇鏇村淇℃伅锛屽彂鐜扮煕鐩炬椂鐐瑰嚮"鍑虹ず璇佹嵁"骞堕€夋嫨瀵瑰簲璇佹嵁銆傛纭?20淇″績鍊硷紝閿欒-10銆?
            </div>
          `}
        </div>
      `;

      // 璇佷汉瀵硅瘽锛堢伀鏌翠汉瑙掕壊 + 瀵硅瘽鍘嗗彶锛?
      if (state.currentWitness) {
        const witness = gameWitnesses.find(w => w.id === state.currentWitness);
        if (witness) {
          const dialogContainer = document.getElementById('trial-dialog-container');
          const isFollowedUp = state.interviewedWitnesses.includes(witness.id);
          const testimony = isFollowedUp ? witness.followUpTestimony : witness.initialTestimony;
          const hasContradiction = witness.contradiction && !state.contradictionsFound.find(c => {
            const cont = gameContradictions.find(gc => gc.id === c);
            return cont && cont.witnessId === witness.id;
          });
          
          // 璇佷汉棰滆壊鏄犲皠
          const witnessColors = {
            conductor: '#3b82f6',
            'mrs-hubbard': '#ec4899',
            mary: '#8b5cf6',
            colonel: '#22c55e',
            princess: '#eab308',
            countess: '#06b6d4',
          };
          const witnessColor = witnessColors[witness.id] || '#94a3b8';
          
          // 鏍规嵁鐘舵€佸喅瀹氳〃鎯?
          let expression = 'normal';
          if (state.witnessReaction === 'contradiction') expression = 'angry';
          else if (state.witnessReaction === 'followup') expression = 'thinking';
          else if (state.witnessReaction === 'shocked') expression = 'surprised';
          
          // 鐏煷浜篠VG锛堟敮鎸佽〃鎯咃級
          function stickFigureWithExpr(color, expr, size = 56) {
            const eyes = { normal: '鈼?鈼?, happy: '鈼?鈼?, sad: '鈼?鈼?, angry: '> <', surprised: '鈼?鈼?, thinking: '鈼?-' };
            const mouth = { normal: '鈥?, happy: '鈼?, sad: '鈼?, angry: '锔?, surprised: '鈼?, thinking: '~' };
            return `<svg width="${size}" height="${size * 1.4}" viewBox="0 0 100 140" class="drop-shadow-lg"><circle cx="50" cy="25" r="18" fill="none" stroke="${color}" stroke-width="3"/><text x="50" y="28" text-anchor="middle" font-size="10" fill="${color}">${eyes[expr] || eyes.normal}</text><text x="50" y="38" text-anchor="middle" font-size="8" fill="${color}">${mouth[expr] || mouth.normal}</text><line x1="50" y1="43" x2="50" y2="90" stroke="${color}" stroke-width="3"/><line x1="50" y1="55" x2="25" y2="75" stroke="${color}" stroke-width="3"/><line x1="50" y1="55" x2="75" y2="75" stroke="${color}" stroke-width="3"/><line x1="50" y1="90" x2="35" y2="125" stroke="${color}" stroke-width="3"/><line x1="50" y1="90" x2="65" y2="125" stroke="${color}" stroke-width="3"/></svg>`;
          }
          
          // 瀵硅瘽鍘嗗彶HTML
          const historyHtml = state.dialogueHistory && state.dialogueHistory.length > 0 
            ? state.dialogueHistory.slice(-8).map(h => `
                <div class="flex gap-2 text-sm py-1 border-b border-stone-700/50">
                  <span class="font-medium flex-shrink-0" style="color: ${h.color}">${h.speaker}锛?/span>
                  <span class="text-stone-400">${h.text.substring(0, 60)}${h.text.length > 60 ? '...' : ''}</span>
                </div>
              `).join('')
            : '<p class="text-stone-500 text-sm text-center py-2">鏆傛棤瀵硅瘽鍘嗗彶</p>';
          
          dialogContainer.innerHTML = `
            <div class="bg-stone-800 rounded-xl overflow-hidden">
              <!-- 瀵硅瘽鍘嗗彶鏍?-->
              <div class="bg-stone-900/50 px-4 py-2 flex items-center justify-between border-b border-stone-700">
                <span class="text-xs text-stone-400">瀵硅瘽璁板綍 (${state.dialogueHistory?.length || 0})</span>
                <button class="text-xs text-primary-400 hover:text-primary-300" onclick="window.__toggleTrialHistory()">${state.showHistory ? '鏀惰捣' : '鏌ョ湅鍘嗗彶'}</button>
              </div>
              <!-- 鍘嗗彶闈㈡澘 -->
              <div id="trial-history-panel" class="${state.showHistory ? '' : 'hidden'} max-h-32 overflow-y-auto bg-stone-900/30 px-4 py-2">
                ${historyHtml}
              </div>
              <!-- 瀵硅瘽鍐呭 -->
              <div class="p-6">
                <div class="flex items-start gap-4 mb-4">
                  <div class="flex-shrink-0">
                    ${stickFigureWithExpr(witnessColor, expression)}
                  </div>
                  <div class="pt-2">
                    <h3 class="font-bold text-lg" style="color: ${witnessColor}">${witness.name}</h3>
                    <p class="text-xs text-stone-500">${expression === 'angry' ? '鎯呯华锛氭縺鍔? : expression === 'thinking' ? '鎯呯华锛氭€濊€? : expression === 'surprised' ? '鎯呯华锛氭儕璁? : '鎯呯华锛氬钩闈?}</p>
                  </div>
                </div>
                <p class="text-stone-300 leading-relaxed mb-6 min-h-20">${testimony}</p>
                <div class="flex gap-3 justify-end">
                  ${!isFollowedUp ? `<button class="px-4 py-2 bg-stone-600 rounded-lg hover:bg-stone-500 transition-colors" onclick="window.__followUp()">杩介棶</button>` : ''}
                  ${hasContradiction ? `<button class="px-4 py-2 bg-yellow-600 rounded-lg hover:bg-yellow-500 font-bold transition-all hover:scale-105" onclick="window.__presentEvidence()">鍑虹ず璇佹嵁</button>` : ''}
                  <button class="px-4 py-2 bg-stone-700 rounded-lg hover:bg-stone-600 transition-colors" onclick="window.__closeWitnessDialog()">鍏抽棴</button>
                </div>
              </div>
            </div>
          `;
        }
      } else {
        document.getElementById('trial-dialog-container').innerHTML = '';
      }
    }

    // 缁撳眬娓叉煋
    function renderEnding() {
      document.getElementById('ending-section').classList.remove('hidden');
      const choice = state.choices['final-choice'];
      let ending;
      if (choice === 'reveal') {
        ending = { name: '鐪熺浉澶х櫧', description: '浣犳彮闇蹭簡鐪熺浉锛?2鍚嶄箻瀹㈤兘鏄嚩鎵嬶紝浠栦滑涓轰簡缁欓樋濮嗘柉鐗规湕涓€瀹跺浠囷紝姣忎汉鍒轰簡涓€鍒€銆備綘閫夋嫨灏嗙湡鐩稿憡璇夎鏂广€傛涔夊緱鍒颁簡浼稿紶锛屼絾娉曞涔嬫儏涔熶护浜哄攺鍢樸€? };
      } else {
        ending = { name: '娉曞瀹规儏', description: '浣犳彮闇蹭簡鐪熺浉锛屼絾鐞嗚В浜?2浜虹殑鍔ㄦ満銆備綘閫夋嫨鍚戣鏂归殣鐬掔湡鐩革紝璇村嚩鎵嬪凡缁忛€冭蛋銆傛涔夛紝鏈夋椂鍦ㄦ硶寰嬩箣澶栥€傛尝娲涚殑鍐呭績锛屾垨璁告案杩滀笉浼氬钩闈欍€? };
      }
      
      document.getElementById('ending-title').textContent = ending.name;
      document.getElementById('ending-description').textContent = ending.description;
      document.getElementById('stat-evidence').textContent = state.collectedEvidence.length;
      document.getElementById('stat-witness').textContent = state.interviewedWitnesses.length;
      document.getElementById('stat-contradiction').textContent = state.contradictionsFound.length;
      document.getElementById('stat-confidence').textContent = state.confidence;
    }

    // 璇佹嵁鏍忔覆鏌?
    function renderEvidenceBar() {
      const container = document.getElementById('evidence-bar-container');
      if (!state.showEvidenceBar) {
        container.innerHTML = '';
        return;
      }
      
      const evidence = state.collectedEvidence.map(id => gameEvidence.find(e => e.id === id)).filter(Boolean);
      container.innerHTML = `
        <div class="fixed bottom-0 left-0 right-0 bg-stone-900 p-4 z-50 border-t border-stone-700">
          <div class="container-page">
            <div class="flex items-center justify-between mb-3">
              <h3 class="font-bold">${state.evidenceMode === 'select' ? '閫夋嫨瑕佸嚭绀虹殑璇佹嵁' : `璇佹嵁鏍?(${evidence.length})`}</h3>
              ${state.evidenceMode === 'select' ? `<button class="text-sm text-stone-400 hover:text-white" onclick="window.__cancelEvidence()">鍙栨秷</button>` : ''}
            </div>
            ${evidence.length === 0 ? '<p class="text-stone-400 text-sm">杩樻病鏈夋敹闆嗗埌浠讳綍璇佹嵁</p>' : `
              <div class="flex gap-3 overflow-x-auto pb-2">
                ${evidence.map(e => `
                  <button class="flex-shrink-0 w-40 p-3 rounded-lg text-left transition-all ${state.selectedEvidence === e.id ? 'bg-primary-600 ring-2 ring-primary-400' : 'bg-stone-800 hover:bg-stone-700'}" onclick="window.__selectEvidence('${e.id}')">
                    <div class="font-bold text-sm mb-1">${e.name}</div>
                    <div class="text-xs text-stone-300">${e.description}</div>
                    ${state.selectedEvidence === e.id && state.evidenceMode === 'select' ? '<div class="mt-2 text-xs text-primary-200">鐐瑰嚮纭鍑虹ず</div>' : ''}
                  </button>
                `).join('')}
              </div>
            `}
            ${state.evidenceMode === 'select' && state.selectedEvidence ? `
              <button class="mt-3 w-full py-2 bg-yellow-600 rounded-lg font-bold hover:bg-yellow-500" onclick="window.__confirmPresentEvidence()">
                纭鍑虹ず銆?{gameEvidence.find(e => e.id === state.selectedEvidence)?.name}銆?
              </button>
            ` : ''}
          </div>
        </div>
      `;
    }


    // 璁板綍瀵硅瘽鍘嗗彶
    function addDialogueHistory(speaker, text, color) {
      if (!state.dialogueHistory) state.dialogueHistory = [];
      state.dialogueHistory.push({ speaker, text, color, time: Date.now() });
      // 鏈€澶氫繚鐣?0鏉?
      if (state.dialogueHistory.length > 50) {
        state.dialogueHistory = state.dialogueHistory.slice(-50);
      }
    }
    
    // 鍒囨崲瀵硅瘽鍘嗗彶鏄剧ず
    window.__toggleTrialHistory = function() {
      state.showHistory = !state.showHistory;
      const panel = document.getElementById('trial-history-panel');
      if (panel) panel.classList.toggle('hidden');
      renderTrial();
    };
    
    // 璁剧疆璇佷汉琛ㄦ儏
    function setWitnessReaction(reaction) {
      state.witnessReaction = reaction;
      setTimeout(() => {
        state.witnessReaction = 'normal';
        if (state.currentWitness) renderTrial();
      }, 2000);
    }

    // 娓告垙浜や簰鍑芥暟
    window.__introContinue = function() {
      state.dialogIndex++;
      if (state.dialogIndex >= 12) {
        state.gamePhase = 'investigation';
        state.currentScene = 'corridor';
        state.dialogIndex = 0;
      }
      render();
    };

    window.__interact = function(itemId) {
      const scene = gameScenes.find(s => s.id === state.currentScene);
      const item = scene?.interactables.find(i => i.id === itemId);
      if (!item) return;

      if (item.type === 'evidence' && item.evidenceId) {
        if (!state.collectedEvidence.includes(item.evidenceId)) {
          const evidence = gameEvidence.find(e => e.id === item.evidenceId);
          // 浣跨敤璇佹嵁鍗＄墖鏇夸唬alert
          GameUI.showEvidenceCard(evidence, (ev) => {
            state.collectedEvidence.push(ev.id);
            GameUI.showToast(`鏀堕泦鍒拌瘉鎹細${ev.name}`, 'success');
            // 鑷姩娣诲姞鍒扮瑪璁扮嚎绱?
            PlayerData.addNotebookItem('clues', `銆愯瘉鎹€?{ev.name}锛?{ev.description}`);
            // 鎾斁鏀堕泦鍔ㄧ敾
            const rect = event.target.getBoundingClientRect();
            GameUI.playCollectAnimation(rect.left, rect.top, ev.name);
            render();
          });
        } else {
          const evidence = gameEvidence.find(e => e.id === item.evidenceId);
          GameUI.showEvidenceCard(evidence, null);
        }
      } else if (item.type === 'witness' && item.witnessId) {
        if (!state.interviewedWitnesses.includes(item.witnessId)) {
          state.interviewedWitnesses.push(item.witnessId);
          GameUI.showToast(`璇㈤棶浜?{gameWitnesses.find(w => w.id === item.witnessId)?.name}`, 'info');
        }
        const witness = gameWitnesses.find(w => w.id === item.witnessId);
        const witnessColors = {
          conductor: '#3b82f6',
          'mrs-hubbard': '#ec4899',
          mary: '#8b5cf6',
          colonel: '#22c55e',
          princess: '#eab308',
          countess: '#06b6d4',
        };
        const color = witnessColors[witness.id] || '#94a3b8';
        // 浣跨敤瀵硅瘽妗嗘浛浠lert
        GameUI.showDialog({
          speaker: witness.name,
          color: color,
          text: witness.initialTestimony,
          options: witness.followUpTestimony ? [{
            text: '杩介棶鏇村缁嗚妭',
            action: () => {
              GameUI.showDialog({
                speaker: witness.name,
                color: color,
                text: witness.followUpTestimony,
              });
            }
          }] : [],
        });
      } else if (item.type === 'object') {
        GameUI.showDialog({
          speaker: '',
          color: '#94a3b8',
          text: item.description,
        });
      }
      render();
    };

    window.__exit = function(sceneId) {
      if (sceneId === 'dining-car' && state.gamePhase === 'investigation') {
        if (state.collectedEvidence.length >= 3 && state.interviewedWitnesses.length >= 3) {
          GameUI.showModal({
            title: '杩涘叆瀹″垽闃舵锛?,
            message: '璋冩煡闃舵灏嗙粨鏉燂紝鏈敹闆嗙殑璇佹嵁灏嗘棤娉曡幏鍙栥€傜‘瀹氳鍓嶅線椁愯溅杩涜瀹″垽鍚楋紵',
            confirmText: '杩涘叆瀹″垽',
            cancelText: '缁х画璋冩煡',
            type: 'warning',
            onConfirm: () => {
              state.gamePhase = 'trial';
              state.currentScene = 'dining-car';
              render();
            }
          });
        } else {
          GameUI.showModal({
            title: '杩樹笉鑳借繘鍏ュ鍒?,
            message: `杩橀渶瑕佹敹闆嗚嚦灏?浠惰瘉鎹拰璇㈤棶3涓瘉浜恒€俓n褰撳墠锛氳瘉鎹?{state.collectedEvidence.length}/3锛岃瘉浜?{state.interviewedWitnesses.length}/3`,
            confirmText: '鎴戠煡閬撲簡',
            cancelText: '鍏抽棴',
            type: 'info',
            onConfirm: () => {},
            onCancel: () => {}
          });
          return;
        }
      }
      state.currentScene = sceneId;
      render();
    };

    window.__selectWitness = function(witnessId) {
      state.currentWitness = witnessId;
      if (!state.interviewedWitnesses.includes(witnessId)) {
        state.interviewedWitnesses.push(witnessId);
      }
      render();
    };

    window.__followUp = function() {
      const witness = gameWitnesses.find(w => w.id === state.currentWitness);
      if (witness) {
        const witnessColors = {
          conductor: '#3b82f6',
          'mrs-hubbard': '#ec4899',
          mary: '#8b5cf6',
          colonel: '#22c55e',
          princess: '#eab308',
          countess: '#06b6d4',
        };
        const color = witnessColors[witness.id] || '#94a3b8';
        GameUI.showDialog({
          speaker: witness.name,
          color: color,
          text: witness.followUpTestimony,
        });
      }
      render();
    };

    window.__presentEvidence = function() {
      state.evidenceMode = 'select';
      state.showEvidenceBar = true;
      render();
    };

    window.__selectEvidence = function(evidenceId) {
      if (state.evidenceMode === 'select') {
        state.selectedEvidence = evidenceId;
        render();
      } else {
        const evidence = gameEvidence.find(e => e.id === evidenceId);
        GameUI.showEvidenceCard(evidence, null);
      }
    };

    window.__cancelEvidence = function() {
      state.evidenceMode = 'view';
      state.selectedEvidence = null;
      state.showEvidenceBar = false;
      render();
    };

    window.__confirmPresentEvidence = function() {
      const witness = gameWitnesses.find(w => w.id === state.currentWitness);
      const evidence = gameEvidence.find(e => e.id === state.selectedEvidence);
      
      if (witness?.contradiction && witness.contradiction.evidenceId === state.selectedEvidence) {
        // 姝ｇ‘鎸囧嚭鐭涚浘
        const cont = gameContradictions.find(c => c.witnessId === witness.id && c.evidenceId === state.selectedEvidence);
        if (cont && !state.contradictionsFound.includes(cont.id)) {
          state.contradictionsFound.push(cont.id);
          state.confidence = Math.min(100, state.confidence + 20);
          GameUI.showDialog({
            speaker: '娉㈡礇',
            color: '#fbbf24',
            text: `姝ｇ‘锛佸彂鐜扮煕鐩撅紒\n\n${witness.contradiction.revealedText}\n\n淇″績鍊?+20`,
          });
        }
      } else {
        // 閿欒
        state.confidence = Math.max(0, state.confidence - 10);
        GameUI.showToast('杩欎釜璇佹嵁涓庤瘉璇嶆病鏈夌洿鎺ョ煕鐩?.. 淇″績鍊?-10', 'warning', 3000);
      }
      
      state.evidenceMode = 'view';
      state.selectedEvidence = null;
      state.showEvidenceBar = false;
      render();
    };

    window.__closeWitnessDialog = function() {
      state.currentWitness = null;
      render();
    };

    window.__goToEnding = function() {
      state.gamePhase = 'ending';
      render();
    };

    window.__makeFinalChoice = function(choice) {
      GameUI.showModal({
        title: '鍋氬嚭鏈€缁堥€夋嫨锛?,
        message: '杩欏皢鍐冲畾娓告垙缁撳眬锛屾棤娉曟洿鏀广€傜‘瀹氳鍋氬嚭杩欎釜閫夋嫨鍚楋紵',
        confirmText: '纭畾',
        cancelText: '鍐嶆兂鎯?,
        type: 'danger',
        onConfirm: () => {
          state.choices['final-choice'] = choice;
          render();
        }
      });
    };

    // 璇佹嵁鏍忔寜閽?
    document.getElementById('evidence-btn')?.addEventListener('click', () => {
      state.showEvidenceBar = !state.showEvidenceBar;
      state.evidenceMode = 'view';
      render();
    });

    // 閲嶇疆鎸夐挳
    document.getElementById('reset-btn')?.addEventListener('click', () => {
      GameUI.showModal({
        title: '閲嶇疆娓告垙锛?,
        message: '鎵€鏈夎繘搴﹀皢涓㈠け锛岀‘瀹氳閲嶇疆鍚楋紵',
        confirmText: '閲嶇疆',
        cancelText: '鍙栨秷',
        type: 'danger',
        onConfirm: () => {
        localStorage.removeItem('fun-detective-prototype-save');
        state = {
          currentScene: 'intro',
          gamePhase: 'intro',
          collectedEvidence: [],
          interviewedWitnesses: [],
          contradictionsFound: [],
          confidence: 100,
          choices: {},
          dialogIndex: 0,
          currentWitness: null,
          showEvidenceBar: false,
          selectedEvidence: null,
          evidenceMode: 'view',
        };
        render();
        }
      });
    });

    // 寮€鍦虹户缁寜閽?
    document.getElementById('intro-continue')?.addEventListener('click', () => {
      window.__introContinue();
    });

    // 缁撳眬閲嶆柊寮€濮?
    document.getElementById('ending-restart')?.addEventListener('click', () => {
      localStorage.removeItem('fun-detective-prototype-save');
      window.location.reload();
    });

    // 鍚姩
    init();
  </script>

  <!-- 寮曞叆娓告垙UI宸ュ叿妯″潡 -->
  <script is:inline src="/fun_detective/game/ui.js"></script>
  <!-- 寮曞叆鐜╁鏁版嵁涓庣瑪璁扮郴缁?-->
  <script is:inline src="/fun_detective/game/playerData.js"></script>
  <script is:inline src="/fun_detective/game/notebookUI.js"></script>
</BaseLayout>
