---
import BaseLayout from '@layouts/BaseLayout.astro';
import GameScene from '@components/prototype/GameScene.astro';
import EvidenceBar from '@components/prototype/EvidenceBar.astro';
import DialogBox from '@components/prototype/DialogBox.astro';
import TrialPanel from '@components/prototype/TrialPanel.astro';
import { gameScenes, gameEvidence, gameWitnesses, gameDialogs } from '@data/prototype-orient-express';
---

<BaseLayout title="东方快车：推理审判" description="可交互推理游戏原型">
  <div class="min-h-screen bg-stone-900 text-white">
    <!-- 游戏顶部栏 -->
    <div class="bg-stone-800 p-3 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/fun_detective/game-design/prototype" class="text-stone-400 hover:text-white text-sm">← 返回</a>
        <span class="font-bold">东方快车：推理审判</span>
      </div>
      <div class="flex items-center gap-4 text-sm">
        <span id="phase-indicator" class="text-stone-300">开场</span>
        <span id="confidence-display" class="text-stone-300">信心值: 100</span>
        <button id="audio-toggle-btn" onclick="GameInteractions.toggleAudio()" class="px-2 py-1 bg-stone-700 rounded hover:bg-stone-600 text-sm" title="静音/取消静音">
          🔊
        </button>
        <button id="evidence-btn" class="px-3 py-1 bg-stone-700 rounded hover:bg-stone-600">
          证据 (<span id="evidence-count">0</span>)
        </button>
        <button onclick="EvidenceBoard.openBoard()" class="px-3 py-1 bg-purple-700 rounded hover:bg-purple-600 text-xs">
          🔗 关联
        </button>
        <button onclick="TimelineUI.open()" class="px-3 py-1 bg-blue-700 rounded hover:bg-blue-600 text-xs">
          ⏱️ 时间线
        </button>
        <button onclick="NotebookUI.open()" class="px-3 py-1 bg-amber-700 rounded hover:bg-amber-600 text-xs">
          📝 笔记
        </button>
        <button id="reset-btn" class="px-3 py-1 bg-red-800 rounded hover:bg-red-700 text-xs">重置</button>
      </div>
    </div>

    <!-- 游戏主区域 -->
    <div class="container-page py-6 pb-32">
      <!-- 开场/对话阶段 -->
      <div id="intro-section" class="max-w-2xl mx-auto">
        <div class="bg-stone-800 rounded-xl p-8 min-h-64 flex flex-col justify-between">
          <div id="intro-text" class="text-lg leading-relaxed text-stone-200"></div>
          <button id="intro-continue" class="mt-6 self-end px-6 py-2 bg-primary-600 rounded-lg hover:bg-primary-700">
            继续
          </button>
        </div>
      </div>

      <!-- 调查阶段 -->
      <div id="investigation-section" class="hidden">
        <div class="mb-4">
          <h2 class="text-xl font-bold mb-2">🔍 调查阶段</h2>
          <p class="text-sm text-stone-400">点击场景中的物品和人物进行互动。收集至少3件证据、询问至少2个证人后，可前往餐车进行审判。</p>
          <div class="mt-2 flex gap-4 text-sm">
            <span>已收集证据: <span id="inv-evidence-count" class="text-accent-400 font-bold">0</span>/3</span>
            <span>已询问证人: <span id="inv-witness-count" class="text-accent-400 font-bold">0</span>/2</span>
          </div>
        </div>
        <div id="game-scene-container"></div>
      </div>

      <!-- 审判阶段 -->
      <div id="trial-section" class="hidden max-w-4xl mx-auto">
        <div id="trial-panel-container"></div>
        <div id="trial-dialog-container" class="mt-6"></div>
      </div>

      <!-- 结局阶段 -->
      <div id="ending-section" class="hidden max-w-2xl mx-auto">
        <div class="bg-stone-800 rounded-xl p-8">
          <div id="ending-grade"></div>
          <h2 id="ending-title" class="text-3xl font-bold mb-4 text-center"></h2>
          <p id="ending-description" class="text-lg leading-relaxed text-stone-300 mb-6"></p>
          <div id="ending-stats" class="bg-stone-700 rounded-lg p-4 mb-6">
            <h3 class="font-bold mb-2">游戏统计</h3>
            <div class="grid grid-cols-2 gap-2 text-sm">
              <div>收集证据: <span id="stat-evidence"></span></div>
              <div>询问证人: <span id="stat-witness"></span></div>
              <div>揭露矛盾: <span id="stat-contradiction"></span></div>
              <div>最终信心值: <span id="stat-confidence"></span></div>
            </div>
          </div>
          <div class="flex gap-4 justify-center">
            <button id="ending-restart" class="px-6 py-2 bg-primary-600 rounded-lg hover:bg-primary-700">重新开始</button>
            <a href="/fun_detective/game-design" class="px-6 py-2 bg-stone-600 rounded-lg hover:bg-stone-500">返回游戏设计</a>
          </div>
        </div>
      </div>
    </div>

    <!-- 证据栏 -->
    <div id="evidence-bar-container"></div>

    <!-- 异议动画遮罩 -->
    <div id="objection-overlay" class="hidden fixed inset-0 z-[100] flex items-center justify-center bg-black/80 pointer-events-none">
      <div class="objection-text text-8xl font-black text-red-500 animate-bounce" style="text-shadow: 0 0 20px rgba(239,68,68,0.8); transform: rotate(-5deg);">
        异议！
      </div>
    </div>

    <!-- 时间线弹窗 -->
    <div id="timeline-overlay" class="hidden fixed inset-0 z-[90] flex items-center justify-center bg-black/70">
      <div class="bg-stone-800 rounded-xl p-6 w-full max-w-2xl max-h-[80vh] overflow-hidden border border-stone-600">
        <div class="flex items-center justify-between mb-4">
          <div></div>
          <button onclick="TimelineUI.close()" class="text-stone-400 hover:text-white text-xl">✕</button>
        </div>
        <div id="timeline-content"></div>
      </div>
    </div>

    <!-- 对话框 -->
    <div id="dialog-container"></div>
  </div>

  <!-- 引入案件配置（必须在动态加载之前） -->
  <script is:inline src="/fun_detective/game/cases/index.js"></script>
  <!-- 引入音效系统 -->
  <script is:inline src="/fun_detective/game/audio-config.js"></script>
  <script is:inline src="/fun_detective/game/audioManager.js"></script>
  <!-- 引入游戏UI工具模块 -->
  <script is:inline src="/fun_detective/game/ui.js"></script>
  <!-- 引入玩家数据与笔记系统 -->
  <script is:inline src="/fun_detective/game/playerData.js"></script>
  <script is:inline src="/fun_detective/game/notebookUI.js"></script>
  <!-- 引入证据关联系统 -->
  <script is:inline src="/fun_detective/game/evidence-board.js"></script>
  <!-- 引入时间线系统 -->
  <script is:inline src="/fun_detective/game/timelineUI.js"></script>

    <!-- 引入游戏核心模块（按依赖顺序） -->
  <script is:inline src="/fun_detective/game/gameState.js"></script>
  <script is:inline src="/fun_detective/game/gameRender.js"></script>
  <script is:inline src="/fun_detective/game/gameInteractions.js"></script>

  <script is:inline>
    // 游戏初始化：加载案件数据后初始化
    GameState.loadCaseData(GameState.currentCaseId, () => {
      GameState.init();
    });
  </script>
</BaseLayout>
