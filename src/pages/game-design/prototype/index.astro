---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="案件选择 - Fun Detective" description="选择一个案件开始你的推理之旅">
  <div class="container-page py-8">
    <!-- 页面标题 -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-white mb-2">🔍 案件选择</h1>
      <p class="text-stone-400">选择一个案件，开始你的推理之旅</p>
    </div>

    <!-- 案件列表 -->
    <div id="cases-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- 案件卡片由JS动态渲染 -->
    </div>

    <!-- 即将推出提示 -->
    <div class="mt-12 p-6 bg-stone-800/50 rounded-xl border border-stone-700">
      <h3 class="text-lg font-bold text-stone-300 mb-2">📚 更多案件即将推出</h3>
      <p class="text-stone-400 text-sm">我们正在持续扩充案件库，包括更多推理小说经典、真实案件改编和原创案件。如果你有想玩的案件，欢迎反馈！</p>
    </div>
  </div>

  <!-- 引入案件配置 -->
  <script is:inline src="/fun_detective/game/cases/index.js"></script>

  <script is:inline>
    // 渲染案件列表
    function renderCases() {
      const container = document.getElementById('cases-container');
      if (!container || !window.GameCases) return;

      container.innerHTML = window.GameCases.map(c => `
        <div class="case-card bg-stone-800 rounded-xl overflow-hidden border border-stone-700 hover:border-amber-500/50 transition-all cursor-pointer group"
             onclick="startCase('${c.id}')">
          <!-- 封面区域 -->
          <div class="h-32 bg-gradient-to-br from-stone-700 to-stone-900 flex items-center justify-center text-5xl group-hover:scale-105 transition-transform">
            ${c.cover || '📁'}
          </div>
          <!-- 信息区域 -->
          <div class="p-5">
            <div class="flex items-start justify-between mb-2">
              <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors">${c.name}</h3>
              <span class="text-xs px-2 py-1 rounded-full ${
                c.difficulty === '简单' ? 'bg-green-900/50 text-green-400' :
                c.difficulty === '中等' ? 'bg-amber-900/50 text-amber-400' :
                'bg-red-900/50 text-red-400'
              }">${c.difficulty}</span>
            </div>
            <p class="text-stone-400 text-sm mb-3 line-clamp-3">${c.description}</p>
            <div class="flex items-center justify-between text-xs text-stone-500">
              <span>⏱ ${c.estimatedTime || '未知'}</span>
              <div class="flex gap-1">
                ${(c.tags || []).slice(0, 2).map(t => `<span class="px-2 py-0.5 bg-stone-700 rounded">${t}</span>`).join('')}
              </div>
            </div>
          </div>
        </div>
      `).join('');
    }

    // 开始案件
    function startCase(caseId) {
      window.location.href = `/fun_detective/game-design/prototype/play?case=${caseId}`;
    }

    // 初始化
    renderCases();
  </script>
</BaseLayout>
