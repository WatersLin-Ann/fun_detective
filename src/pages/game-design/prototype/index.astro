---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const isDev = import.meta.env.DEV;
---

<BaseLayout title="案件选择 - Fun Detective" description="选择一个案件开始你的推理之旅">
  <!-- 线上环境遮罩：游戏仅本地测试 -->
  {!isDev && (
    <div class="fixed inset-0 z-50 flex items-center justify-center" style="background: rgba(13,13,18,0.95); backdrop-filter: blur(8px);">
      <div class="text-center px-6 max-w-md">
        <div class="text-6xl mb-6">🔒</div>
        <h2 class="text-2xl font-bold mb-3" style="color: #e8e8f0;">游戏原型内部测试中</h2>
        <p class="text-base mb-2" style="color: #8888a0;">可玩游戏原型目前仅在本地开发环境开放。</p>
        <p class="text-sm mb-8" style="color: #666680;">线上版本暂不提供游戏体验，您可以继续浏览案件资料库。</p>
        <a href="/fun_detective/" class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-bold text-sm transition-colors" style="background: #f59e0b; color: #0d0d12;">
          返回案件资料库
        </a>
      </div>
    </div>
  )}

  <!-- 案件档案室：深色沉浸区域，与游戏壳视觉一致 -->
  <div class="min-h-[70vh]" style="background: var(--game-bg, #0d0d12);">
    <div class="container-page py-12">
      <!-- 页面标题 -->
      <div class="mb-10 text-center">
        <h1 class="text-4xl font-bold mb-3" style="color: var(--game-text, #e8e8f0);">🔍 案件档案室</h1>
        <p class="text-lg" style="color: var(--game-text-muted, #8888a0);">选择一个案件，开始你的推理之旅</p>
      </div>

      <!-- 案件列表 -->
      <div id="cases-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- 案件卡片由JS动态渲染 -->
      </div>

      <!-- 即将推出提示 -->
      <div class="mt-12 p-6 rounded-xl border" style="background: var(--game-surface, #1a1a24); border-color: var(--game-border, #2e2e3e);">
        <h3 class="text-lg font-bold mb-2" style="color: var(--game-text, #e8e8f0);">📚 更多案件即将推出</h3>
        <p class="text-sm" style="color: var(--game-text-muted, #8888a0);">我们正在持续扩充案件库，包括更多推理小说经典、真实案件改编和原创案件。如果你有想玩的案件，欢迎反馈！</p>
      </div>
    </div>
  </div>

  <!-- 引入案件配置 -->
  <script is:inline src="/fun_detective/game/cases/index.js"></script>

  <script is:inline>
    // 渲染案件列表
    function renderCases() {
      const container = document.getElementById('cases-container');
      if (!container || !window.GameCases) return;

      container.innerHTML = window.GameCases.map(c => `
        <a href="/fun_detective/game-design/prototype/play?case=${c.id}"
           class="case-card group block rounded-xl overflow-hidden border transition-all focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-[#0d0d12] hover:scale-[1.02] hover:shadow-xl"
           style="background: var(--game-surface, #1a1a24); border-color: var(--game-border, #2e2e3e); --tw-ring-color: var(--game-accent, #f59e0b); min-height: 280px; display: flex; flex-direction: column;"
           aria-label="开始案件：${c.name}">
          <!-- 封面区域 -->
          <div class="h-32 flex items-center justify-center text-5xl group-hover:scale-110 transition-transform"
               style="background: linear-gradient(135deg, var(--game-surface-hover, #252532), var(--game-bg, #0d0d12));">
            ${c.cover || '📁'}
          </div>
          <!-- 信息区域 -->
          <div class="p-5 flex-1 flex flex-col">
            <div class="flex items-start justify-between mb-2">
              <h3 class="text-lg font-bold group-hover:transition-colors" style="color: var(--game-text, #e8e8f0);">${c.name}</h3>
              <span class="text-xs px-2 py-1 rounded-full flex-shrink-0 ml-2 ${
                c.difficulty === '简单' ? 'bg-green-900/50 text-green-400' :
                c.difficulty === '中等' ? 'bg-amber-900/50 text-amber-400' :
                'bg-red-900/50 text-red-400'
              }">${c.difficulty}</span>
            </div>
            <p class="text-sm mb-3 line-clamp-3 flex-1" style="color: var(--game-text-muted, #8888a0);">${c.description}</p>
            <div class="flex items-center justify-between text-xs mb-4" style="color: var(--game-text-muted, #8888a0);">
              <span>⏱ ${c.estimatedTime || '未知'}</span>
              <div class="flex gap-1">
                ${(c.tags || []).slice(0, 2).map(t => `<span class="px-2 py-0.5 rounded" style="background: var(--game-surface-hover, #252532);">${t}</span>`).join('')}
              </div>
            </div>
            <!-- 明确的 CTA 按钮 -->
            <div class="flex items-center justify-center py-2.5 rounded-lg font-bold text-sm transition-colors"
                 style="background: var(--game-accent, #f59e0b); color: #0d0d12; min-height: 44px;">
              开始案件 →
            </div>
          </div>
        </a>
      `).join('');
    }

    // 初始化
    renderCases();
  </script>
</BaseLayout>
