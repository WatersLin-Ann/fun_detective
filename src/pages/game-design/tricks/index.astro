---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getTrickMechanismMap, getGameTemplates, loadAllCases } from '@lib/caseLoader';

const trickMap = getTrickMechanismMap();
const templates = getGameTemplates();
const allCases = loadAllCases();

const trickNames = Object.keys(trickMap);

// 收集所有适配游戏类型
const allGameTypes = new Set<string>();
trickNames.forEach((name) => {
  (trickMap[name].适配游戏类型 || []).forEach((t) => allGameTypes.add(t));
});

// 为每个诡计找到参考案例
function getRelatedCases(trickName: string) {
  return allCases.filter((c) => (c.设计视图.诡计类型 || []).includes(trickName)).slice(0, 5);
}

// 为每个诡计找到适配的模板
function getRelatedTemplates(trickName: string) {
  return Object.keys(templates).filter((tName) => (templates[tName].适配诡计类型 || []).includes(trickName));
}
---

<BaseLayout title="诡计机制映射" description="10种经典推理诡计类型对应的游戏机制、关卡设计要点和参考案例">
  <div class="container-page py-8">
    <!-- 面包屑 -->
    <nav class="text-sm text-stone-500 mb-6">
      <a href="/fun_detective/game-design" class="hover:text-primary-600">游戏设计</a>
      <span class="mx-2">/</span>
      <span class="text-stone-700">诡计机制映射</span>
    </nav>

    <!-- 页面头部 -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold mb-3">诡计类型 → 游戏机制映射</h1>
      <p class="text-lg text-stone-600">10种经典推理诡计类型，每种都有对应的游戏机制、关卡设计要点和参考案例</p>
    </div>

    <!-- 搜索和筛选 -->
    <div class="card p-4 mb-8 sticky top-20 z-40 bg-white">
      <div class="flex flex-col md:flex-row gap-4">
        <div class="flex-1">
          <input
            id="trick-search"
            type="text"
            placeholder="搜索诡计名称或核心机制..."
            class="w-full px-4 py-2 border border-stone-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500"
          />
        </div>
        <div class="flex flex-wrap gap-2 items-center">
          <span class="text-sm text-stone-500">筛选：</span>
          {[...allGameTypes].map((type) => (
            <label class="flex items-center gap-1 text-sm cursor-pointer">
              <input type="checkbox" class="trick-filter rounded" value={type} />
              <span>{type}</span>
            </label>
          ))}
        </div>
      </div>
    </div>

    <div class="flex gap-8">
      <!-- 主内容 -->
      <div class="flex-1">
        <div id="tricks-list" class="space-y-8">
          {trickNames.map((name) => {
            const trick = trickMap[name];
            const relatedCases = getRelatedCases(name);
            const relatedTemplates = getRelatedTemplates(name);
            return (
              <section id={name} class="card p-6 trick-section" data-trick={name} data-types={(trick.适配游戏类型 || []).join(',')}>
                <h2 class="text-2xl font-bold mb-3 text-primary-800">{name}</h2>
                <p class="text-stone-600 mb-4">{trick.描述}</p>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                  <div>
                    <h4 class="text-sm font-bold text-stone-500 mb-2">适配游戏类型</h4>
                    <div class="flex flex-wrap gap-1.5">
                      {(trick.适配游戏类型 || []).map((t) => (
                        <span class="tag tag-primary">{t}</span>
                      ))}
                    </div>
                  </div>
                  <div>
                    <h4 class="text-sm font-bold text-stone-500 mb-2">核心机制</h4>
                    <div class="flex flex-wrap gap-1.5">
                      {(trick.核心机制 || []).map((m) => (
                        <span class="tag tag-accent">{m}</span>
                      ))}
                    </div>
                  </div>
                </div>

                <div class="mb-4">
                  <h4 class="text-sm font-bold text-stone-500 mb-2">关卡设计要点</h4>
                  <ul class="text-sm text-stone-600 space-y-1">
                    {(trick.关卡设计要点 || []).map((tip, i) => (
                      <li>• {tip}</li>
                    ))}
                  </ul>
                </div>

                {relatedTemplates.length > 0 && (
                  <div class="mb-4">
                    <h4 class="text-sm font-bold text-stone-500 mb-2">适配游戏模板</h4>
                    <div class="flex flex-wrap gap-2">
                      {relatedTemplates.map((tName) => (
                        <a href={`/fun_detective/game-design/templates/${encodeURIComponent(tName)}`} class="text-sm text-primary-600 hover:underline bg-primary-50 px-3 py-1 rounded-full">
                          {tName} →
                        </a>
                      ))}
                    </div>
                  </div>
                )}

                {relatedCases.length > 0 && (
                  <div>
                    <h4 class="text-sm font-bold text-stone-500 mb-2">参考案例 ({relatedCases.length})</h4>
                    <div class="flex flex-wrap gap-2">
                      {relatedCases.map((c) => (
                        <a href={`/fun_detective/case/${c.slug}`} class="text-sm text-stone-600 hover:text-primary-600 hover:underline bg-stone-50 px-3 py-1 rounded-full">
                          {c.基本信息.案件名称}
                        </a>
                      ))}
                    </div>
                  </div>
                )}
              </section>
            );
          })}
        </div>
        <div id="no-results" class="hidden text-center py-12 text-stone-500">
          没有找到匹配的诡计类型
        </div>
      </div>

      <!-- 侧边导航（桌面端） -->
      <aside class="hidden lg:block w-48 flex-shrink-0">
        <div class="sticky top-32">
          <h3 class="text-sm font-bold text-stone-500 mb-3">快速跳转</h3>
          <nav class="space-y-1">
            {trickNames.map((name) => (
              <a
                href={`#${name}`}
                class="block text-sm text-stone-600 hover:text-primary-600 py-1 px-2 rounded hover:bg-primary-50 transition-colors trick-nav-link"
                data-target={name}
              >
                {name}
              </a>
            ))}
          </nav>
        </div>
      </aside>
    </div>
  </div>

  <script>
    // 搜索和筛选
    const searchInput = document.getElementById('trick-search');
    const filterCheckboxes = document.querySelectorAll('.trick-filter');
    const trickSections = document.querySelectorAll('.trick-section');
    const noResults = document.getElementById('no-results');

    function filterTricks() {
      const searchTerm = (searchInput?.value || '').toLowerCase();
      const selectedTypes = Array.from(filterCheckboxes)
        .filter((cb) => cb.checked)
        .map((cb) => cb.value);

      let visibleCount = 0;

      trickSections.forEach((section) => {
        const trickName = section.dataset.trick?.toLowerCase() || '';
        const types = section.dataset.types?.split(',') || [];
        const text = section.textContent?.toLowerCase() || '';

        const matchesSearch = !searchTerm || trickName.includes(searchTerm) || text.includes(searchTerm);
        const matchesFilter = selectedTypes.length === 0 || selectedTypes.some((t) => types.includes(t));

        if (matchesSearch && matchesFilter) {
          section.classList.remove('hidden');
          visibleCount++;
        } else {
          section.classList.add('hidden');
        }
      });

      if (noResults) {
        noResults.classList.toggle('hidden', visibleCount > 0);
      }
    }

    searchInput?.addEventListener('input', filterTricks);
    filterCheckboxes.forEach((cb) => cb.addEventListener('change', filterTricks));

    // 平滑滚动
    document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener('click', function (e) {
        const targetId = this.getAttribute('href')?.substring(1);
        if (targetId) {
          const target = document.getElementById(targetId);
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            history.replaceState(null, '', `#${targetId}`);
          }
        }
      });
    });

    // 滚动高亮侧边导航
    const navLinks = document.querySelectorAll('.trick-nav-link');
    window.addEventListener('scroll', () => {
      let current = '';
      trickSections.forEach((section) => {
        const rect = section.getBoundingClientRect();
        if (rect.top <= 150) {
          current = section.id;
        }
      });
      navLinks.forEach((link) => {
        if (link.dataset.target === current) {
          link.classList.add('text-primary-600', 'bg-primary-50', 'font-medium');
        } else {
          link.classList.remove('text-primary-600', 'bg-primary-50', 'font-medium');
        }
      });
    });
  </script>
</BaseLayout>
