---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到" description="404 - 页面未找到">
  <section class="py-20">
    <div class="container-page text-center">
      <div class="text-8xl font-bold text-primary-200 mb-4">404</div>
      <h1 class="text-2xl font-bold mb-4">页面未找到</h1>
      <p class="text-stone-600 mb-8">抱歉，您访问的页面不存在或已被移动。</p>
      <a href="/fun_detective/" class="btn btn-primary">
        返回首页
      </a>
    </div>
  </section>
</BaseLayout>
