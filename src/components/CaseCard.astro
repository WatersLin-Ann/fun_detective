---
import type { CaseWithSlug } from '@lib/types';

interface Props {
  caseData: CaseWithSlug;
}

const { caseData } = Astro.props;
const { 基本信息, 设计视图, 元数据 } = caseData;

// 难度等级
function getDifficultyLevel(score: number): string {
  if (score <= 2) return 'easy';
  if (score <= 3.5) return 'medium';
  return 'hard';
}

const difficulty = 设计视图.难度评分?.综合 || 0;
const difficultyLevel = getDifficultyLevel(difficulty);

// 搜索文本（用于客户端搜索）
const searchText = [
  基本信息.案件名称,
  基本信息.一句话简介,
  基本信息.来源作品 || '',
  基本信息.作者 || '',
  设计视图.核心诡计简述 || '',
  ...(设计视图.诡计类型 || []),
  ...(设计视图.可复用机制 || []),
].join(' ');
---

<article
  class="card flex flex-col"
  data-case
  data-name={基本信息.案件名称}
  data-source={caseData.sourceType}
  data-region={caseData.region}
  data-difficulty={difficulty}
  data-date={元数据.录入日期 || ''}
  data-searchtext={searchText}
>
  <!-- 卡片头部 -->
  <div class="p-5 flex-1 flex flex-col">
    <div class="flex items-start justify-between gap-2 mb-3">
      <span class={`tag ${difficultyLevel === 'easy' ? 'difficulty-easy' : difficultyLevel === 'medium' ? 'difficulty-medium' : 'difficulty-hard'}`}>
        难度 {difficulty.toFixed(1)}
      </span>
      <span class="tag tag-primary">{caseData.sourceType}</span>
    </div>

    <h3 class="text-lg font-bold mb-2 line-clamp-2 hover:text-primary-700 transition-colors">
      <a href={`/fun_detective/case/${caseData.slug}`}>
        {基本信息.案件名称}
      </a>
    </h3>

    <p class="text-stone-600 text-sm mb-4 line-clamp-3 flex-1">
      {基本信息.一句话简介}
    </p>

    <!-- 标签 -->
    <div class="flex flex-wrap gap-1.5 mb-3">
      {(设计视图.诡计类型 || []).slice(0, 3).map((trick) => (
        <span class="tag tag-accent">{trick}</span>
      ))}
    </div>

    <!-- 元信息 -->
    <div class="flex items-center justify-between text-xs text-stone-500 pt-3 border-t border-stone-100">
      <span class="flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        {caseData.region}
      </span>
      <span>{基本信息.案件状态}</span>
    </div>
  </div>
</article>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
