---
import type { CaseWithSlug } from '@lib/types';

interface Props {
  caseData: CaseWithSlug;
}

const { caseData } = Astro.props;
const { 基本信息, 设计视图, 元数据 } = caseData;

// 难度等级
function getDifficultyLevel(score: number): string {
  if (score <= 2) return 'easy';
  if (score <= 3.5) return 'medium';
  return 'hard';
}

const difficulty = 设计视图.难度评分?.综合 || 0;
const difficultyLevel = getDifficultyLevel(difficulty);

// 延伸阅读数量
const refLinkCount = (基本信息.参考链接 || []).length;
const videoCount = (基本信息.推荐视频 || []).length;
const hasExtendedReading = refLinkCount > 0 || videoCount > 0;

// 按来源类型生成确定性视觉封面（纯 CSS/SVG，无外部图片依赖与版权风险）
const coverTheme: Record<string, { gradient: string; icon: string; label: string }> = {
  推理小说: {
    gradient: 'linear-gradient(135deg, #312e81 0%, #4f46e5 100%)',
    icon: 'book',
    label: '推理小说',
  },
  真实案件: {
    gradient: 'linear-gradient(135deg, #7f1d1d 0%, #b91c1c 100%)',
    icon: 'search',
    label: '真实案件',
  },
  游戏: {
    gradient: 'linear-gradient(135deg, #92400e 0%, #d97706 100%)',
    icon: 'gamepad',
    label: '游戏案例',
  },
  影视: {
    gradient: 'linear-gradient(135deg, #1e3a5f 0%, #0369a1 100%)',
    icon: 'film',
    label: '影视',
  },
};
const cover = coverTheme[caseData.sourceType] || {
  gradient: 'linear-gradient(135deg, #44403c 0%, #78716c 100%)',
  icon: 'search',
  label: caseData.sourceType,
};

// 搜索文本（用于客户端搜索）
const searchText = [
  基本信息.案件名称,
  基本信息.一句话简介,
  基本信息.来源作品 || '',
  基本信息.作者 || '',
  设计视图.核心诡计简述 || '',
  ...(设计视图.诡计类型 || []),
  ...(设计视图.可复用机制 || []),
].join(' ');
---

<article
  class="card card-clickable flex flex-col"
  data-case
  data-name={基本信息.案件名称}
  data-source={caseData.sourceType}
  data-continent={caseData.continent}
  data-region={caseData.region}
  data-difficulty={difficulty}
  data-date={元数据.录入日期 || ''}
  data-year={基本信息.发表年份 || ''}
  data-searchtext={searchText}
>
  <!-- 来源类型视觉封面（确定性生成，替代空白图片区） -->
  <div
    class="case-cover"
    role="img"
    aria-label={`${cover.label} · ${caseData.continent}${caseData.region} · ${基本信息.案件名称}`}
    style={`background:${cover.gradient};`}
  >
    <div class="case-cover-meta">
      <span class="case-cover-type">{cover.label}</span>
      <span class="case-cover-region">{caseData.continent} · {caseData.region}</span>
    </div>
    <svg class="case-cover-icon" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      {cover.icon === 'book' && (
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
      )}
      {cover.icon === 'search' && (
        <>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 11h4m-2-2v4" />
        </>
      )}
      {cover.icon === 'gamepad' && (
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 12h4M9 10v4m5-1h.01M17 11h.01M3 9a3 3 0 013-3h12a3 3 0 013 3v6a3 3 0 01-5.4 1.8L14 15H10l-1.6 1.8A3 3 0 013 15V9z" />
      )}
      {cover.icon === 'film' && (
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 4h16a1 1 0 011 1v14a1 1 0 01-1 1H4a1 1 0 01-1-1V5a1 1 0 011-1z" />
      )}
    </svg>
  </div>

  <!-- 卡片头部 -->
  <div class="p-4 flex-1 flex flex-col">
    <div class="flex items-start justify-between gap-2 mb-2">
      <span class={`tag ${difficultyLevel === 'easy' ? 'difficulty-easy' : difficultyLevel === 'medium' ? 'difficulty-medium' : 'difficulty-hard'}`}>
        难度 {difficulty.toFixed(1)}
      </span>
      <span class="tag tag-primary">{caseData.sourceType}</span>
    </div>

    <h3 class="text-base font-bold mb-2 line-clamp-2 card-title">
      <a
        class="card-stretched-link"
        href={`/fun_detective/case/${caseData.slug}`}
        aria-label={`${基本信息.案件名称}（${caseData.sourceType} · ${caseData.region}），查看案件详情`}
      >
        {基本信息.案件名称}
      </a>
    </h3>

    <p class="text-stone-600 text-sm mb-3 line-clamp-2 flex-1">
      {基本信息.一句话简介}
    </p>

    <!-- 标签 -->
    <div class="flex flex-wrap gap-1 mb-2">
      {(设计视图.诡计类型 || []).slice(0, 2).map((trick) => (
        <span class="tag tag-accent">{trick}</span>
      ))}
    </div>

    <!-- 延伸阅读引导 -->
    {hasExtendedReading && (
      <div class="flex items-center gap-3 text-xs text-stone-500 mb-2">
        {refLinkCount > 0 && (
          <span class="inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            {refLinkCount}篇资料
          </span>
        )}
        {videoCount > 0 && (
          <span class="inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            {videoCount}个视频
          </span>
        )}
      </div>
    )}

    <!-- 元信息 -->
    <div class="flex items-center justify-between text-xs text-stone-500 pt-2 border-t border-stone-100">
      <span class="flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        {caseData.continent} · {caseData.region}
      </span>
      <span class="flex items-center gap-2">
        {基本信息.发表年份 && (
          <span class="flex items-center gap-0.5">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            {基本信息.发表年份}
          </span>
        )}
        <span>{基本信息.案件状态}</span>
      </span>
    </div>
  </div>
</article>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ===== 卡片视觉封面 ===== */
  .card-clickable {
    position: relative;
  }
  .case-cover {
    position: relative;
    height: 72px;
    overflow: hidden;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 10px 12px;
    color: rgba(255, 255, 255, 0.95);
  }
  .case-cover-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    z-index: 1;
  }
  .case-cover-type {
    align-self: flex-start;
    font-size: 11px;
    font-weight: 600;
    padding: 1px 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(2px);
  }
  .case-cover-region {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.82);
  }
  .case-cover-icon {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    color: rgba(255, 255, 255, 0.12);
  }

  /* ===== 移动端横向布局 ===== */
  @media (max-width: 768px) {
    .card-clickable {
      flex-direction: row !important;
    }
    .case-cover {
      width: 40%;
      height: auto;
      min-height: 100%;
      flex-shrink: 0;
    }
    .case-cover-icon {
      width: 32px;
      height: 32px;
      right: 8px;
    }
    .card-clickable > div:not(.case-cover) {
      width: 60%;
      padding: 12px !important;
    }
  }

  /* ===== 整卡可点击（stretched-link：只有一个语义链接，覆盖整张卡片） ===== */
  .card-stretched-link {
    color: inherit;
    text-decoration: none;
  }
  .card-stretched-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .card-clickable:hover .card-title {
    color: #4338ca;
  }
  .card-clickable:has(.card-stretched-link:focus-visible) {
    outline: 2px solid #6366f1;
    outline-offset: 2px;
  }
  .card-stretched-link:focus-visible {
    outline: none;
  }
</style>
