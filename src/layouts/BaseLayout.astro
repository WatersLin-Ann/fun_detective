---
import '@styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '全球虚拟真实案件案例库，为小说创作和游戏设计提供灵感' } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Fun Detective</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700&family=Noto+Serif+SC:wght@400;600&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- 头部导航 -->
    <header class="bg-primary-950 text-white sticky top-0 z-50 shadow-md">
      <div class="container-page">
        <div class="flex items-center justify-between h-16">
          <a href="/fun_detective/" class="flex items-center gap-2 hover:opacity-90 transition-opacity">
            <svg class="w-8 h-8 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span class="text-xl font-bold">Fun Detective</span>
          </a>
          <nav class="hidden md:flex items-center gap-6">
            <a href="/fun_detective/" class="hover:text-accent-400 transition-colors">首页</a>
            <a href="/fun_detective/categories/推理小说" class="hover:text-accent-400 transition-colors">推理小说</a>
            <a href="/fun_detective/categories/真实案件" class="hover:text-accent-400 transition-colors">真实案件</a>
            <a href="/fun_detective/categories/游戏" class="hover:text-accent-400 transition-colors">游戏案例</a>
            <a href="/fun_detective/game-design" class="hover:text-accent-400 transition-colors">游戏设计</a>
            <a href="/fun_detective/about" class="hover:text-accent-400 transition-colors">关于</a>
          </nav>
          <button id="mobile-menu-btn" class="md:hidden p-2 hover:bg-primary-800 rounded-lg">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
        <!-- 移动端菜单 -->
        <div id="mobile-menu" class="hidden md:hidden pb-4">
          <nav class="flex flex-col gap-2">
            <a href="/fun_detective/" class="px-3 py-2 rounded-lg hover:bg-primary-800">首页</a>
            <a href="/fun_detective/categories/推理小说" class="px-3 py-2 rounded-lg hover:bg-primary-800">推理小说</a>
            <a href="/fun_detective/categories/真实案件" class="px-3 py-2 rounded-lg hover:bg-primary-800">真实案件</a>
            <a href="/fun_detective/categories/游戏" class="px-3 py-2 rounded-lg hover:bg-primary-800">游戏案例</a>
            <a href="/fun_detective/game-design" class="px-3 py-2 rounded-lg hover:bg-primary-800">游戏设计</a>
            <a href="/fun_detective/about" class="px-3 py-2 rounded-lg hover:bg-primary-800">关于</a>
          </nav>
        </div>
      </div>
    </header>

    <!-- 主内容 -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- 底部 -->
    <footer class="bg-stone-900 text-stone-400 mt-16">
      <div class="container-page py-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <h3 class="text-white font-bold text-lg mb-4">Fun Detective</h3>
            <p class="text-sm">全球虚拟真实案件案例库，为小说创作和游戏设计提供灵感与参考。</p>
          </div>
          <div>
            <h3 class="text-white font-bold text-lg mb-4">快速链接</h3>
            <ul class="space-y-2 text-sm">
              <li><a href="/fun_detective/" class="hover:text-white transition-colors">首页</a></li>
              <li><a href="/fun_detective/categories/推理小说" class="hover:text-white transition-colors">推理小说</a></li>
              <li><a href="/fun_detective/categories/真实案件" class="hover:text-white transition-colors">真实案件</a></li>
              <li><a href="/fun_detective/categories/游戏" class="hover:text-white transition-colors">游戏案例</a></li>
              <li><a href="/fun_detective/game-design" class="hover:text-white transition-colors">游戏设计</a></li>
            </ul>
          </div>
          <div>
            <h3 class="text-white font-bold text-lg mb-4">数据来源</h3>
            <p class="text-sm mb-2">案件数据维护在飞书多维表格，自动同步至 GitHub。</p>
            <a href="https://github.com/WatersLin-Ann/fun_detective" target="_blank" rel="noopener noreferrer" class="text-accent-400 hover:text-accent-300 text-sm inline-flex items-center gap-1">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              GitHub 仓库
            </a>
          </div>
        </div>
        <div class="border-t border-stone-800 mt-8 pt-8 text-center text-sm">
          <p>&copy; 2026 Fun Detective. 仅供学习和创作参考。</p>
        </div>
      </div>
    </footer>

    <script>
      // 移动端菜单切换
      const menuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      if (menuBtn && mobileMenu) {
        menuBtn.addEventListener('click', () => {
          mobileMenu.classList.toggle('hidden');
        });
      }
    </script>
  </body>
</html>
